// ============================================================================
// PHASE 0 — NABH FOUNDATION MODELS
// Shared infrastructure consumed by every later phase (consent, admission
// handshake, daily closure, staff handover, OT, incident, discharge AI).
// ============================================================================

// Generic in-app audit log. Distinct from HmisAuditLog (which captures
// HMIS push/pull traffic only). This table records WHO did WHAT inside
// Docminds for any clinically- or financially-relevant event.
//
// Tied to NABH IMS.5 (audit trail) and PSQ.7 (incident traceability).
// Every Phase 1+ controller writes one row per user-driven write.
model AppAuditLog {
  id         String   @id @default(uuid())
  module     String // e.g. "patient" | "consent" | "incident" | "ipd" | "ot"
  action     String // e.g. "CREATE" | "UPDATE" | "STATUS_CHANGE" | "SIGN" | "DELETE"
  entityType String? // e.g. "IpdAdmission" | "IncidentReport" | "ConsentSignature"
  entityId   String? // FK as string (works for both Int and UUID source tables)
  payload    String?  @db.LongText // optional JSON snapshot of what changed
  notes      String?  @db.Text // free text reason (e.g., override reason)
  actorId    Int? // User.id when present (matches existing createdById pattern)
  actorName  String? // snapshot of username at time of action
  actorRole  String? // role snapshot (super_admin | sub_admin | admin | doctor | unknown)
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([module, action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Reusable signature capture record. One row per signature event
// (consent sign-off, MAR attender ack, handover sign, CAPA close, etc.).
// The actual signature image is stored at `blobUrl` (S3 / GCS / local).
//
// Tied to NABH PRE.4 (informed consent), AAC.10.d (handover sign-off),
// COP.14.e (operative note signature), PSQ.7 (incident closure ack).
model SignatureBlob {
  id                String   @id @default(uuid())
  blobUrl           String // image URL (data URI for small inline, otherwise object-storage URL)
  mimeType          String   @default("image/png")
  signerType        String // "doctor" | "nurse" | "patient" | "attender" | "supervisor" | "witness" | "other"
  signerId          Int? // User.id when the signer is staff; null for patient/attender
  signerName        String // snapshot — never deleted even if user is removed
  signerRole        String? // role snapshot for staff signers
  signerRelation    String? // for attender: "father" | "spouse" | etc.
  capturedAt        DateTime @default(now())
  deviceFingerprint String? // browser fingerprint for forensic trail
  ipAddress         String?
  sha256Hash        String? // hash of the blob bytes — integrity check
  contextType       String? // optional reverse-link: "consent" | "handover" | "mar-ack" | "capa" | "incident-close"
  contextId         String? // id of the consuming row (kept loose so any model can link)
  createdAt         DateTime @default(now())

  @@index([signerType, signerId])
  @@index([contextType, contextId])
  @@index([capturedAt])
}

// Lightweight feature-flag table. Each phase ships behind a flag so the
// hospital can enable rollout per-ward / per-role.
//
// Reads are cached on the frontend on app boot; writes are admin-only.
model FeatureFlag {
  id           Int      @id @default(autoincrement())
  flagKey      String   @unique // e.g. "phase8.incident-module"
  description  String
  enabled      Boolean  @default(false)
  rolloutScope String   @default("global") // "global" | "role:doctor" | "ward:icu-1" | comma list
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedById  Int?
  updatedBy    String?

  @@index([flagKey])
  @@index([enabled])
}
