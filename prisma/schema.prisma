  updatedAt DateTime @updatedAt

  cancelledBy String?
  cancelledAt DateTime?
}

// ============================================================================
// EMERGENCY & TRAUMA MODULE (Phase 0)
// ============================================================================

model Emergency {
  id            Int     @id @default(autoincrement())
  prn           String  @unique // Auto-generated ER case no: JMRH-ER-001
  appointmentId Int?
  patientPrn    String? // Patient master PRN (links the ER case to the Patient record)
  patientName   String
  phoneNumber   String?
  age           Int?
  gender        String?
  allergies     String? @db.Text // Known allergies / drug reactions captured at intake

  triageCategory      String // red | yellow | green | black
  presentingComplaint String @db.LongText
  abcdeAssessment     String @db.LongText

  traumaScore Int? // ISS (Injury Severity Score) or GCS
  vitalsBP    String?
  vitalsHR    Int?
  vitalsRR    Int?
  vitalsSpO2  Int?
  vitalsTemp  Float?

  proceduresDone String? @db.LongText
  status         String // arrived | stabilized | referred | admitted-ipd | shifted-ot | LAMA | DAMA | discharged | expired

  docmindsCreated Boolean @default(true)
  hmisCreated     Boolean @default(false)
  hmisEmergencyId String?

  // ─── Phase 6 — Emergency intake form fields (NABH AAC.1) ──────────────
  // Mirrors the printed UHJ/EMR/F-01 Initial Assessment Sheet.
  modeOfArrival          String? // 'walk-in' | 'ambulance' | 'private-vehicle' | 'transferred'
  broughtBy              String? // 'self' | 'family' | 'police' | 'paramedic' | other free-text
  historyGivenBy         String?
  referralFrom           String?
  referredTo             String?
  identificationMark     String?   @db.Text // for MLC body
  policeInformationGiven Boolean   @default(false)
  reasonsForMlc          String?   @db.Text
  painScore              Int? // 0-10 at intake
  // Primary survey
  airway                 String?   @db.Text
  breathing              String?   @db.Text
  circulation            String?   @db.Text
  mentalStatus           String?
  pupilsRight            String?
  pupilsLeft             String?
  secondarySurvey        String?   @db.LongText
  workingDiagnosis       String?   @db.Text
  // ER hand-off — ER staff hand to ward/ICU/admitting team
  handOffDoctorName      String?
  handOffDoctorAt        DateTime?
  receivingDoctorName    String?
  receivingDoctorAt      DateTime?
  handOffNurseName       String?
  handOffNurseAt         DateTime?
  receivingNurseName     String?
  receivingNurseAt       DateTime?
  conditionAtDisposition String? // 'stable' | 'fair' | 'critical'
  disposition            String? // 'home' | 'ram' | 'icu' | 'ot' | 'other-hospital'

  // Form 5 (Phase 8) — single-row oxygen support summary (drug-table sibling).
  // Drugs/treatments themselves live on EmergencyTreatment[].
  oxygenFlowRate Float? // litres / min
  oxygenDelivery String? // 'nasal-cannula' | 'face-mask' | 'venturi' | 'nrbm' | 'bipap' | 'cpap' | etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  progressNotes  EmergencyProgressNote[]
  mlcCase        MlcCase?
  lamaRecord     LamaRecord?
  damaRecord     DamaRecord?
  // Form 5 (Phase 8) — sub-entity tables for the printed UHJ/EMR/F-01 grids.
  investigations EmergencyInvestigation[]
  treatments     EmergencyTreatment[]
  procedures     EmergencyProcedure[]
  specimens      EmergencySpecimen[]
  referrals      EmergencyReferral[]

  @@index([prn])
  @@index([status])
  @@index([createdAt])
}

model EmergencyProgressNote {
  id          Int      @id @default(autoincrement())
  emergencyId Int
  time        DateTime @default(now())
  doctorName  String
  observation String   @db.LongText

  vitalsBP   String?
  vitalsHR   Int?
  vitalsRR   Int?
  vitalsSpO2 Int?
  vitalsTemp Float?

  createdAt DateTime @default(now())
  createdBy String?

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([time])
}

// ─── Form 5 (Phase 8) — UHJ/EMR/F-01 sub-entity tables ────────────────────
// Each ER intake row in the printed form has multiple sub-grids that the
// proceduresDone free-text blob can't represent. These four models give
// each grid its own typed lifecycle.

// Investigation orders (bloods, imaging, ECG, etc.) — printed form has a
// row per investigation with order / sent / report time + sign.
model EmergencyInvestigation {
  id          Int    @id @default(autoincrement())
  emergencyId Int
  category    String // 'blood' | 'imaging' | 'ecg' | 'other'
  name        String // 'GRBS' | 'ABG' | 'CBC' | 'X-Ray Chest' etc.

  orderedAt   DateTime  @default(now())
  orderedBy   String?
  sentAt      DateTime?
  sentBy      String?
  reportedAt  DateTime?
  reportedBy  String?
  resultNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([category])
}

// Treatment initiated — drug interventions started in ER (one row per
// drug). Oxygen support is a single line on Emergency itself
// (oxygenFlowRate + oxygenDelivery), not here.
model EmergencyTreatment {
  id          Int @id @default(autoincrement())
  emergencyId Int

  drug      String
  dose      String?
  route     String?
  frequency String?
  givenAt   DateTime?
  givenBy   String?
  signedBy  String?
  signedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
}

// Procedures done in ER (IV access, RT insertion, Foley's, etc.) — one
// row per procedure with timestamp + nurse / doctor sign.
model EmergencyProcedure {
  id          Int @id @default(autoincrement())
  emergencyId Int

  procedure   String // 'iv-access' | 'rt-insertion' | 'foleys' | other free text
  performedAt DateTime @default(now())
  performedBy String?
  signatureId String?
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  createdBy String?

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([procedure])
}

// Material preserved — forensic / lab specimen chain of custody. Captures
// container, amount, nurse sign, doctor sign, handed-over-to chain. The
// printed form is the source of truth for MLC sample handling.
model EmergencySpecimen {
  id          Int @id @default(autoincrement())
  emergencyId Int

  container      String?
  amount         String?
  nurseSign      String?
  doctorSign     String?
  handedOverTo   String?
  handedOverSign String?
  handedOverAt   DateTime?
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  emergency Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
}

model MlcCase {
  id          Int    @id @default(autoincrement())
  emergencyId Int    @unique
  mlcNo       String @unique // Auto: MLC-YYYY-001
  caseType    String // accident | assault | poison | burn | other

  policeStationName    String?
  fir_No               String?
  fir_Date             DateTime?
  investigatingOfficer String?

  // NABH MRD.2 — incident / intimation / examination detail (additive, all nullable)
  incidentDateTime      DateTime?
  incidentPlace         String?
  allegedCause          String?   @db.Text
  weaponType            String?
  broughtBy             String?
  broughtByDetail       String?
  informantName         String?
  informantRelation     String?
  identificationMark1   String?
  identificationMark2   String?
  consentForExamination Boolean?
  consentForExamTime    DateTime?
  injuryOpinion         String? // simple | grievous | dangerous | undetermined
  policeIntimationTime  DateTime?
  policeIntimationMode  String?
  policeIntimationBy    String?
  examiningDoctorRegNo  String?
  referredTo            String?

  patientConsent   Boolean // Consent for treatment documented
  consentTime      DateTime?
  consentSignature String? // URL

  firstExaminationDone Boolean
  firstExaminationTime DateTime?
  examinerName         String?
  examinerSignature    String? // URL

  injuries         String  @db.LongText
  photographsTaken Boolean
  photoUrls        String? @db.Text // JSON array of GCS URLs

  samplesCollected  String? // Blood, saliva, etc.
  sampleStorageInfo String? @db.LongText

  followUpExams String? @db.LongText
  finalReport   String? @db.LongText

  reportSubmittedTo String? // Police, court
  submissionDate    DateTime?
  submissionProof   String? // URL of submission document

  status String // documented | examination-done | samples-collected | report-submitted | closed

  hmisMlcId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  createdById Int? // Sprint 4a — MRD audit typed creator
  updatedById Int? // Sprint 4b — MRD audit typed updater

  emergency       Emergency    @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  injuries_detail MlcInjury[] // NABH MRD.2 — per-injury documentation (distinct from `injuries` free-text)

  @@index([mlcNo])
  @@index([status])
  @@index([emergencyId])
}

// NABH MRD.2 — per-injury documentation child of MlcCase.
model MlcInjury {
  id               Int      @id @default(autoincrement())
  mlcCaseId        Int
  site             String
  injuryType       String?
  size             String?
  ageOfInjury      String?
  weaponLikely     String?
  simpleOrGrievous String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  mlcCase MlcCase @relation(fields: [mlcCaseId], references: [id], onDelete: Cascade)

  @@index([mlcCaseId])
}

model LamaRecord {
  id          Int  @id @default(autoincrement())
  emergencyId Int? @unique // nullable — record links to EITHER an emergency OR an IPD admission
  admissionId String? // IPD/post-op source (mutually exclusive with emergencyId)

  lamaTime         DateTime
  doctorAdvice     String   @db.LongText
  riskExplained    Boolean
  patientSignature String? // URL

  witnessName      String?
  witnessSignature String? // URL
  reasonForLama    String  @db.Text

  hmisLamaId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt // Sprint 4a — MRD.1 timestamp gap-fill
  createdBy   String?
  createdById Int? // Sprint 4a — MRD audit typed creator
  updatedBy   String? // Sprint 4b — MRD audit username updater
  updatedById Int? // Sprint 4b — MRD audit typed updater

  emergency Emergency?    @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  admission IpdAdmission? @relation("IpdAdmissionLamaRecords", fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([admissionId])
}

model DamaRecord {
  id          Int  @id @default(autoincrement())
  emergencyId Int? @unique // nullable — record links to EITHER an emergency OR an IPD admission
  admissionId String? // IPD/post-op source (mutually exclusive with emergencyId)

  dischargeTime         DateTime
  doctorRecommendation  String   @db.LongText
  patientDeclinesAdvice Boolean
  patientSignature      String? // URL

  witnessName      String?
  witnessSignature String? // URL
  followUpAdvice   String? @db.LongText

  hmisDamaId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt // Sprint 4a — MRD.1 timestamp gap-fill
  createdBy   String?
  createdById Int? // Sprint 4a — MRD audit typed creator
  updatedBy   String? // Sprint 4b — MRD audit username updater
  updatedById Int? // Sprint 4b — MRD audit typed updater

  emergency Emergency?    @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  admission IpdAdmission? @relation("IpdAdmissionDamaRecords", fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([emergencyId])
  @@index([admissionId])
}

// ============================================================================
// HMIS AUDIT LOG & INVESTIGATION RESULTS
// ============================================================================

model HmisAuditLog {
  id            Int       @id @default(autoincrement())
  direction     String // push | pull
  module        String // patient | opd | ipd | lab | pharmacy | billing | emergency | mlc | lama | dama
  action        String // create | update | result | webhook
  payload       String    @db.LongText // JSON
  response      String?   @db.LongText // HMIS response
  status        String // success | failed | pending | dead
  retryCount    Int       @default(0)
  // Phase 9 — when retryCount >= maxRetries (3) the dead-letter mover sets
  // status='dead' and `quarantinedAt` so failures don't keep churning the
  // retry queue. The original row stays here as the source of truth for
  // payload + error history; HmisDeadLetter mirrors it for operator action.
  quarantinedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([direction])
  @@index([module])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// PHASE 9 — HMIS SYNC HARDENING
//
// Two operator-facing tables on top of HmisAuditLog:
//   1. HmisDeadLetter — failures that have exhausted retries and need human
//      intervention. Operators can resolve (mark fixed in HMIS), ignore (mark
//      as won't-fix with rationale), or replay (push back to pending).
//   2. HmisConflict — when HMIS returns a value for a field that disagrees
//      with what we have locally (e.g. name mismatch on a pulled patient).
//      The reconciliation queue lets clinicians choose the source of truth.
// ============================================================================
model HmisDeadLetter {
  id Int @id @default(autoincrement())

  originalAuditLogId Int    @unique // FK to the HmisAuditLog row this came from
  module             String
  action             String
  direction          String // push | pull
  payload            String @db.LongText
  errorDetail        String @db.LongText // last response/error JSON
  retryCount         Int

  // ─── Lifecycle ────────────────────────────────────────────────────────
  status String @default("QUARANTINED") // QUARANTINED | RESOLVED | IGNORED | REPLAYED

  // Operator action snapshots
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedById Int?
  resolution   String?   @db.Text // operator's note on how it was handled

  movedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([module])
  @@index([movedAt])
}

// ============================================================================
// PHASE 10 — NABH AUDIT PACK EXPORT
//
// One row per audit-pack export job. Operators trigger an export for a date
// range + scope ('full' | wf-1..wf-5 | 'incident' | 'hmis'). The service
// collects relevant records (signatures, audit log, handovers, closures,
// transfers, discharges, etc.), packs them into a JSON bundle on disk, and
// stamps the row with status='READY' + downloadUrl.
//
// Lifecycle:
//   QUEUED → PROCESSING → READY (download available)
//                       ↘ FAILED (errorDetail captured for retry)
// ============================================================================

// ============================================================================
// NOTE TEMPLATES — department-scoped form layouts for OPD / Discharge
//
// Lets super_admin define which fields appear on a department's discharge or
// OPD note. Doctor picks the template at write time; only those fields render
// on screen and only those fields print. Legacy free-text columns on the
// target tables stay alongside for backward compatibility.
//
// `fields` is a JSON array of:
//   {
//     key: string,           // unique within the template — used as value-map key
//     label: string,         // shown above the input
//     type: 'text' | 'textarea' | 'number' | 'date' | 'datetime'
//          | 'select' | 'multiselect' | 'checkbox' | 'radio'
//          | 'handwritten',  // for OPD canvases (option C)
//     required?: boolean,
//     options?: string[],    // for select/multiselect/radio
//     helpText?: string,
//     placeholder?: string,
//     group?: string,        // section heading
//     order?: number
//   }
//
// Versioning model: SNAPSHOT.
// At sign-time, the row consuming this template (IpdDischarge etc.) copies the
// `fields` array into its own `templatedValues` JSON under `_schema`. After
// that, edits to the live template never affect the signed record — print
// always walks the snapshot. (See header comment on IpdDischarge.)
// ============================================================================
model NoteTemplate {
  id         String @id @default(uuid())
  name       String // e.g. "Cardiology — Standard discharge"
  noteType   String // 'discharge' | 'opd-handwritten' | 'opd-doctor'
  department String

  // Phase 9.21 — doctor-scoped templates. null = department-level template
  // (shared); set = personal to that doctor. Resolution at form time:
  // the doctor's own template wins over the department default.
  doctorId Int?
  doctor   Doctor? @relation("DoctorNoteTemplates", fields: [doctorId], references: [id])

  fields String @db.LongText // JSON array — see header comment

  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // one default per (doctorId|department, noteType)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@index([department, noteType, isActive])
  @@index([doctorId, noteType, isActive])
  @@index([noteType])
}

// ============================================================================
// PHASE 11 — OT WORKFLOW (NABH COP.13 / COP.14 / PSQ.3 / IPC.5.d / MOM.10.d)
//
// Booking → Pre-op → Intra-op → Post-op (PACU) → Outcomes.
//
// Mandatory NABH artefacts produced by these models:
//   • WHO surgical safety checklist with 3 signatures (sign-in / time-out / sign-out)
//   • Pre-anaesthesia evaluation
//   • Anaesthesia chart with HR/BP/SpO2/EtCO2 trend
//   • Operative note before PACU transfer
//   • Implant batch + serial captured for traceability
//   • SSI surveillance rolled up into the IPC dashboard
//
// The legacy `OTDetails` (estimation sub-record) stays alongside as the
// billing-side anchor; the new chain is the clinical surface.
// ============================================================================

model OtRoom {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique // e.g. "OT-1", "OT-MAJOR-2"
  type           String // 'major' | 'minor' | 'cath-lab' | 'endoscopy'
  equipmentClass String? // free-text — e.g. "ortho", "general", "neuro"
  hepaFiltered   Boolean  @default(false)
  status         String   @default("available") // available | in-use | cleaning | maintenance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedules OtSchedule[]

  @@index([status])
}

model OtSchedule {
  id       String @id @default(uuid())
  otRoomId String
  otRoom   OtRoom @relation(fields: [otRoomId], references: [id])

  // Either a clinic estimation or a ward admission can drive a booking.
  estimationId String?
  admissionId  String?
  prn          String? // patient PRN snapshot
  patientName  String?

  date         DateTime // start-of-day anchor for the slot
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?

  // Phase 9.1a — 4-timestamp schedule (mirrors Impulse HMIS "Enter Surgery
  // Time Schedule" dialog): OT admission → surgery start → surgery end →
  // OT discharge. inductionAt + extubationAt drive the Surgery Track Sheet
  // (UHJ/OTS/F-04) timeline. All nullable so legacy rows continue to read.
  otAdmissionAt DateTime?
  otDischargeAt DateTime?
  inductionAt   DateTime?
  extubationAt  DateTime?

  // Phase 9.1a — optional link back to the originating Requisition row.
  // Schedules can still be created directly (estimation / admission path);
  // this FK is only set when the booking came from the requisition queue.
  requisitionId String?
  requisition   OtRequisition? @relation(fields: [requisitionId], references: [id])

  // Team allocation
  surgeonId             Int?
  surgeonName           String?
  anaesthesiologistId   Int?
  anaesthesiologistName String?
  scrubNurseId          Int?
  scrubNurseName        String?
  runnerId              Int?
  runnerName            String?

  procedureName String
  procedureCode String? // ICD/CPT-style code if available
  urgency       String  @default("elective") // elective | urgent | emergency

  // Lifecycle
  // BOOKED → CONFIRMED → IN_PROGRESS → CLOSED
  //                    ↘ CANCELLED (with reason)
  //                    ↘ RESCHEDULED (with reason; new slot id linked)
  status            String  @default("BOOKED")
  cancelReason      String? @db.Text
  rescheduledFromId String? // FK to a previous OtSchedule when this is a reschedule

  // Convenience pointers — the 1:1 children
  preOpChecklistId  String? @unique
  safetyChecklistId String? @unique
  intraOpNoteId     String? @unique
  pacuRecordId      String? @unique
  outcomeId         String? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  preOpChecklist        OtPreOpChecklist?      @relation(name: "ScheduleToPreOp")
  safetyChecklist       OtSafetyChecklist?     @relation(name: "ScheduleToSafety")
  // Phase 9.12 — Ward → OT pre-operative surgical safety checklist
  wardTransferChecklist OtWardToOtChecklist?   @relation(name: "ScheduleToWardTransfer")
  // Phase 9.1c — 1:N. Legacy `intraOpNote` getter callers should switch to
  // `intraOpNotes[0]` (noteNumber=1 is the primary). Field renamed
  // deliberately so any stale `.intraOpNote` usage trips a tsc error.
  intraOpNotes          OtIntraOpNote[]        @relation(name: "ScheduleToIntraOp")
  nursingChart          OtIntraOpNursingChart? @relation(name: "ScheduleToNursing")
  anaesthesiaChart      OtAnaesthesiaChart[]
  pacuRecord            PacuRecord?            @relation(name: "ScheduleToPacu")
  outcome               OtOutcome?             @relation(name: "ScheduleToOutcome")
  // Phase 9.1a — multi-staff + multi-surgery children
  staff                 OtScheduleStaff[]
  surgeries             OtScheduleSurgery[]
  // Phase 9.1b — equipment + consumables ledger
  equipmentUsage        OtEquipmentUsage[]
  consumableIssues      OtConsumableIssue[]
  // Phase 9.5a — emergency surcharge rows (multiple per schedule allowed)
  emrgSurcharges        EmrgSurgerySurcharge[]

  @@index([date])
  @@index([status])
  @@index([otRoomId, date])
  @@index([admissionId])
  @@index([prn])
  @@index([requisitionId])
}

// Phase 9.1a — OT Requisition queue. Ward / consultant raises a request
// for an OT slot; OT manager turns it into an OtSchedule. Mirrors the
// reference HMIS "Enter Requisition" + "Search Requisition" dialogs.
//
// Lifecycle: pending → scheduled (FK back-reference set on the schedule)
//          → cancelled (with reason)
//          → fulfilled (when its schedule transitions to CLOSED)
model OtRequisition {
  id            String  @id @default(uuid())
  requisitionNo String? @unique // human-readable e.g. JMRH-OT-REQ-0001

  // Patient context (snapshot — booking can pre-exist a chosen admission)
  prn             String?
  patientName     String?
  patientAdmitted Boolean @default(false)
  admissionId     String?
  bedCategory     String? // 'ER' | 'Day Care' | etc.
  phoneNumber     String?

  // Booking specifics
  otRoomId         String?
  bookingFrom      DateTime
  bookingTo        DateTime
  primarySurgery   String // free text — denormalized snapshot for queue display
  departmentId     Int?
  categoryCode     String?
  surgeonId        Int?
  surgeonName      String?
  anaesthetistId   Int?
  anaesthetistName String?
  anaesthesiaType  String?

  // Additional surgeries — JSON array of { departmentId, name, categoryCode }
  additionalSurgeries Json?

  specialInstructions String? @db.Text
  requisitionBy       String?
  requisitionById     Int?

  // Origin — set when this requisition was raised from a confirmed SM
  // estimation (EstimationDetails.estimationId). Used to pre-fill + to
  // prevent a second requisition for the same estimation.
  estimationId String?

  // Lifecycle
  status       String       @default("pending") // pending | scheduled | cancelled | fulfilled
  cancelReason String?      @db.Text
  schedules    OtSchedule[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  @@index([status])
  @@index([prn])
  @@index([admissionId])
  @@index([bookingFrom])
  @@index([estimationId])
}

// Phase 9.1a — Multi-staff per schedule (junction). Mirrors the reference
// HMIS "Enter Surgeon" dialog: role + primary flag, multiple staff per role
// allowed. The legacy singleton columns on OtSchedule (surgeonId, etc.)
// stay as a denormalized snapshot for backward compatibility — readers can
// migrate to this table over time.
model OtScheduleStaff {
  id         Int        @id @default(autoincrement())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  staffId   Int? // User.id when known
  staffName String // always populated (snapshot)
  role      String // 'surgeon' | 'co-surgeon' | 'assistant-surgeon' | 'anaesthetist' | 'scrub-nurse' | 'floor-nurse' | 'runner' | 'technician'
  isPrimary Boolean @default(false)
  surgeryId Int? // optional FK to OtScheduleSurgery row (when staff is per-surgery, not per-session)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([scheduleId])
  @@index([staffId])
  @@index([role])
}

// Phase 9.1a — Multi-surgery per schedule. Mirrors the reference HMIS
// "Enter Surgery" dialog with Department / Category / Surgery / Type +
// "Primary Surgery for Visit" checkbox. One OtSchedule = one OT session
// in one room; can hold multiple surgeries on the same patient.
model OtScheduleSurgery {
  id         Int        @id @default(autoincrement())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  departmentId   Int?
  departmentName String?
  categoryCode   String? // 'Category Level 4A' etc.
  surgeryName    String
  surgeryCode    String? // ICD/CPT-style code
  surgeryType    String? // 'Invasive' | 'Non-Invasive' | etc.
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([scheduleId])
  @@index([departmentId])
}

// Phase 9.1c — OT Clearance (UHJ/IPS/F-32). One row per schedule;
// billing dept marks 'cleared' before BOOKED → CONFIRMED transition.
// Bypass allowed when urgency='emergency' + bypassReason supplied.
model OtClearance {
  id                 String    @id @default(uuid())
  scheduleId         String    @unique
  paymentMode        String? // 'cash' | 'insurance' | 'corporate' | 'other'
  billingNotes       String?   @db.Text
  clearanceStatus    String    @default("pending") // 'pending' | 'cleared' | 'rejected'
  clearedBy          String?
  clearedById        Int?
  clearedAt          DateTime?
  clearedSignatureId String? // SignatureBlob FK — billing in-charge signature
  remarks            String?   @db.Text
  bypassReason       String?   @db.Text // populated when emergency bypass used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([clearanceStatus])
}

// Phase 9.1c — Surgical Notes template (reusable boilerplate for the
// operative note). Mirrors the reference HMIS "Template Selection" /
// "Select Template" dropdown on Surgical Notes screen.
model SurgicalNotesTemplate {
  id           String  @id @default(uuid())
  name         String  @unique
  departmentId Int?
  bodyTemplate String  @db.LongText // structured JSON or markdown
  isActive     Boolean @default(true)

  intraOpNotes OtIntraOpNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([departmentId])
}

// Phase 9.1c — Other Notes template (mirrors the "OtherNotes" template
// selection screen in the reference HMIS — separate from surgical notes,
// used for free-form clinical notes that need reusable templates).
model OtherNotesTemplate {
  id           String  @id @default(uuid())
  name         String  @unique
  departmentId Int?
  bodyTemplate String  @db.LongText
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([departmentId])
}

// Phase 9.1b — Equipment usage per schedule. Mirrors the reference HMIS
// "Enter Equipments" dialog: Surgery + Equipment + Used Time (min).
// Drives the Equipment Utilization report and per-surgery billing.
model OtEquipmentUsage {
  id         Int        @id @default(autoincrement())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  surgeryId     Int? // optional FK to OtScheduleSurgery (if scoped to one surgery in a multi-surgery session)
  equipmentName String // 'C Arm Machine' | 'Electric Tourniquet' | 'Laparoscopic Tower' etc.
  equipmentCode String? // optional asset/inventory ref
  usedMinutes   Int     @default(0)
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([scheduleId])
  @@index([equipmentName])
}

// Phase 9.1b — Consumable Set master + items. Mirrors the reference HMIS
// "Consumables sets" dropdown (General Surgery / Ortho / OBG Surgery /
// Plastic Surgery / Uro Surgery / Inguinal Hernia Mesh Repair / etc.).
// Each set is a named bundle; items inside link to the TabletMaster catalog.
model OtConsumableSet {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  departmentId Int? // optional department scope
  description  String? @db.Text
  isActive     Boolean @default(true)

  items OtConsumableSetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([departmentId])
}

model OtConsumableSetItem {
  id    Int             @id @default(autoincrement())
  setId Int
  set   OtConsumableSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  // Snapshot — the master tablet name is denormalised so a renamed
  // master doesn't silently rewrite a historical set's contents.
  tabletMasterId  Int? // optional FK to TabletMaster.id when item came from the catalog
  itemName        String
  defaultQuantity Int     @default(1)
  uom             String? // 'Number' | 'Pack' | 'ml' etc.

  createdAt DateTime @default(now())

  @@index([setId])
  @@index([tabletMasterId])
}

// Phase 9.1b — Per-schedule consumable issue / return ledger. Each row
// is a physical movement: issued from pharmacy → consumed in OT (or
// returned unused). Pharmacy reconciliation reads this ledger.
model OtConsumableIssue {
  id         Int        @id @default(autoincrement())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  setId          Int? // optional — when issuance came from a named set
  tabletMasterId Int? // optional — when item exists in TabletMaster catalog
  itemName       String // always populated (snapshot)
  quantity       Int
  uom            String?
  itemRemarks    String?
  pharmacyStore  String? // 'IP Pharmacy' | 'OT Pharmacy' etc.
  prescribedBy   String?
  prescribedById Int?

  // 'issued' = drugs went out to OT; 'returned' = unused drugs came back
  direction String   @default("issued") // 'issued' | 'returned'
  issuedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([scheduleId])
  @@index([setId])
  @@index([direction])
}

// COP.13.b — Pre-anaesthesia / pre-op review
model OtPreOpChecklist {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToPreOp", fields: [scheduleId], references: [id], onDelete: Cascade)

  fasting             Boolean   @default(false)
  fastingHours        Int?
  consentSignatureId  String? // FK to ConsentSignature for the surgical consent
  groupTyped          Boolean   @default(false)
  crossMatched        Boolean   @default(false)
  bloodReservedUnits  Int? // total reserved (kept as internal + external sum)
  internalUnitsReserved Int? // units reserved from in-house blood bank
  externalUnitsReserved Int? // units arranged from an external/outside blood bank
  preOpHemoglobin     Float? // pre-op Hb (g/dL)
  surgeryClass        String? // 'minor' | 'intermediate' | 'major'
  anticipatedBloodLossMl Int? // expected blood loss (ml) — justifies the reservation; actual is on OtIntraOpNote
  antibioticPlanned   Boolean   @default(false)
  antibioticName      String?
  prophylaxisGiven    Boolean   @default(false)
  surgicalSiteMarked  Boolean   @default(false)
  allergiesReviewed   Boolean   @default(false)
  allergiesNote       String?   @db.Text
  fitnessCleared      Boolean   @default(false)
  fitnessClearedBy    String?
  preAnaesthesiaNotes String?   @db.Text
  signedAt            DateTime?
  signedBy            String?
  signedById          Int?
  signatureId         String? // SignatureBlob FK — anaesthesiologist sign-off

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

// COP.14.d — WHO Surgical Safety Checklist (sign-in / time-out / sign-out)
model OtSafetyChecklist {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToSafety", fields: [scheduleId], references: [id], onDelete: Cascade)

  // ─── SIGN-IN — before induction of anaesthesia ─────────────────────
  // Phase 9.4b — legacy single signer kept; treated as the SURGEON role.
  // Three additional signature triples (anaesthetist / nurse / technician)
  // added below for the WHO 4-signer chain.
  signInAt                      DateTime?
  signInBy                      String?
  signInSignatureId             String? // SignatureBlob FK — surgeon (legacy column)
  signInAnaesthetistAt          DateTime?
  signInAnaesthetistBy          String?
  signInAnaesthetistSignatureId String?
  signInNurseAt                 DateTime?
  signInNurseBy                 String?
  signInNurseSignatureId        String?
  signInTechnicianAt            DateTime?
  signInTechnicianBy            String?
  signInTechnicianSignatureId   String?
  patientIdentityConfirmed      Boolean   @default(false)
  siteMarked                    Boolean   @default(false)
  anaesthesiaSafetyChecked      Boolean   @default(false)
  pulseOximeterFunctional       Boolean   @default(false)
  knownAllergies                Boolean   @default(false)
  difficultAirwayRisk           Boolean   @default(false)
  bloodLossRisk                 Boolean   @default(false)
  // Phase 9.1c — F-01 sign-in additions
  consentConfirmed              Boolean   @default(false)
  preopMedicationTaken          Boolean   @default(false)
  anaesthEquipSpo2              Boolean   @default(false)
  anaesthEquipNibp              Boolean   @default(false)
  anaesthEquipEcg               Boolean   @default(false)
  anaesthEquipBis               Boolean   @default(false)
  hypothermiaRisk               Boolean   @default(false)
  warmerInPlace                 Boolean   @default(false)
  equipmentImplantsAvailable    Boolean   @default(false)
  // Phase 9.12 — UHJ Nursing Safety Checklist sign-in additions
  fastingStatusConfirmed        Boolean   @default(false)
  ivLineSecured                 Boolean   @default(false)
  bloodAvailabilityChecked      Boolean   @default(false)
  allergyDescription            String?   @db.Text
  bloodLossArrangement          String?   @db.Text
  airwayRiskArrangement         String?   @db.Text

  // ─── TIME-OUT — before skin incision ───────────────────────────────
  timeOutAt                      DateTime?
  timeOutBy                      String?
  timeOutSignatureId             String? // SignatureBlob FK — surgeon (legacy column)
  // Phase 9.4b — multi-role chain
  timeOutAnaesthetistAt          DateTime?
  timeOutAnaesthetistBy          String?
  timeOutAnaesthetistSignatureId String?
  timeOutNurseAt                 DateTime?
  timeOutNurseBy                 String?
  timeOutNurseSignatureId        String?
  timeOutTechnicianAt            DateTime?
  timeOutTechnicianBy            String?
  timeOutTechnicianSignatureId   String?
  teamIntroduced                 Boolean   @default(false)
  procedureConfirmed             Boolean   @default(false)
  antibioticAdministered         Boolean   @default(false)
  imagingDisplayed               Boolean   @default(false)
  criticalEventsAnticipated      Boolean   @default(false)
  // Phase 9.12 — UHJ Nursing Safety Checklist time-out additions
  correctPatientConfirmed        Boolean   @default(false)
  correctSiteConfirmed           Boolean   @default(false)
  sterilityConfirmed             Boolean   @default(false)
  instrumentsAvailable           Boolean   @default(false)
  spongeNeedleCountDone          Boolean   @default(false)
  // Phase 9.1c — F-01 time-out additions
  antibioticName                 String?
  vteProphylaxisProvided         Boolean   @default(false)
  anticipatedDurationMins        Int?
  anticipatedBloodLossMl         Int?
  bloodAvailable                 Boolean   @default(false)
  glycemicControl                String?   @db.Text
  sterilityConcerns              String?   @db.Text
  anaesthetistConcerns           String?   @db.Text

  // ─── SIGN-OUT — before patient leaves OT ───────────────────────────
  signOutAt                      DateTime?
  signOutBy                      String?
  signOutSignatureId             String? // SignatureBlob FK — surgeon (legacy column)
  // Phase 9.4b — multi-role chain
  signOutAnaesthetistAt          DateTime?
  signOutAnaesthetistBy          String?
  signOutAnaesthetistSignatureId String?
  signOutNurseAt                 DateTime?
  signOutNurseBy                 String?
  signOutNurseSignatureId        String?
  signOutTechnicianAt            DateTime?
  signOutTechnicianBy            String?
  signOutTechnicianSignatureId   String?
  procedureRecordedName          String?
  swabCount                      Boolean   @default(false) // counts match
  swabCountInitial               Int?
  swabCountFinal                 Int?
  instrumentCount                Boolean   @default(false)
  instrumentCountInitial         Int?
  instrumentCountFinal           Int?
  specimenLabelled               Boolean   @default(false)
  // Phase 9.12 — UHJ Nursing Safety Checklist sign-out additions
  procedureCompletedConfirmed    Boolean   @default(false)
  postOpInstructionsGiven        Boolean   @default(false)
  patientShiftedSafely           Boolean   @default(false)
  equipmentIssues                String?   @db.Text
  recoveryConcerns               String?   @db.Text
  // Phase 9.1c — F-01 sign-out additions
  correctiveAction               String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

// Phase 9.12 — UHJ "Pre-Operative Surgical Safety Checklist (Ward → OT)".
//
// Distinct from OtSafetyChecklist (the intra-OT WHO sign-in/time-out/
// sign-out). This is the nursing ward-transfer checklist:
//   A. Ward checklist (25 items)  — ward nurse, before patient leaves ward
//   B. Transfer checklist (5 items) — during ward → OT transport
//   C. OT receiving checklist (15 items) — OT nurse, on arrival
// Two-nurse signature chain: ward nurse signs A+B, OT receiving nurse
// signs C. One row per OtSchedule.
model OtWardToOtChecklist {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToWardTransfer", fields: [scheduleId], references: [id], onDelete: Cascade)

  // DRAFT → WARD_SIGNED (ward nurse signed A+B) → OT_RECEIVED (OT nurse signed C)
  status String @default("DRAFT")

  // ─── Section A — Pre-Operative Checklist in Ward (25 items) ─────────
  identityBandChecked           Boolean @default(false)
  surgeryConsentSigned          Boolean @default(false)
  anaesthesiaConsentSigned      Boolean @default(false)
  surgicalSiteMarked            Boolean @default(false)
  preOpAssessmentCompleted      Boolean @default(false)
  allergyStatusChecked          Boolean @default(false)
  investigationsAvailable       Boolean @default(false)
  bloodGroupCrossMatchDone      Boolean @default(false)
  bloodProductsArranged         Boolean @default(false)
  vitalSignsRecorded            Boolean @default(false)
  ivLineSecured                 Boolean @default(false)
  preOpMedicationsGiven         Boolean @default(false)
  antibioticAdministered        Boolean @default(false)
  fastingConfirmed              Boolean @default(false)
  dentureRemoved                Boolean @default(false)
  jewelleryRemoved              Boolean @default(false)
  nailPolishMakeupRemoved       Boolean @default(false)
  contactLensRemoved            Boolean @default(false)
  prosthesisHearingAidRemoved   Boolean @default(false)
  urinaryCatheterSecured        Boolean @default(false)
  skinPreparationCompleted      Boolean @default(false)
  operativeSiteCleanedShaved    Boolean @default(false)
  personalBelongingsHandedOver  Boolean @default(false)
  caseSheetReportsSent          Boolean @default(false)
  patientShiftedOnTrolleySafely Boolean @default(false)
  wardRemarks                   String? @db.Text // per-item remarks, free-form

  // ─── Section B — Transfer from Ward to OT (5 items) ─────────────────
  sideRailsSecured                   Boolean @default(false)
  oxygenSupportProvided              Boolean @default(false)
  emergencyDrugsEquipmentAccompanied Boolean @default(false)
  patientMonitoredDuringTransfer     Boolean @default(false)
  handoverGivenToOtNurse             Boolean @default(false)
  transferRemarks                    String? @db.Text

  // ─── Section C — OT Receiving Checklist (15 items) ──────────────────
  otrIdentityReconfirmed           Boolean @default(false)
  otrSurgerySiteConfirmed          Boolean @default(false)
  otrConsentVerified               Boolean @default(false)
  otrAllergyChecked                Boolean @default(false)
  otrNbmReconfirmed                Boolean @default(false)
  otrInvestigationsAvailable       Boolean @default(false)
  otrImplantsBloodConfirmed        Boolean @default(false)
  otrVitalSignsChecked             Boolean @default(false)
  otrIvAccessPatent                Boolean @default(false)
  otrPreOpMedicationsCompleted     Boolean @default(false)
  otrSurgicalSiteMarkingVisible    Boolean @default(false)
  otrJewelleryDentureRemoved       Boolean @default(false)
  otrFoleyCatheterDrainsChecked    Boolean @default(false)
  otrSkinPreparationAdequate       Boolean @default(false)
  otrPatientShiftedToOtTableSafely Boolean @default(false)
  otReceivingRemarks               String? @db.Text

  // ─── Two-nurse signature chain ──────────────────────────────────────
  wardNurseName               String?
  wardNurseSignedAt           DateTime?
  wardNurseSignedById         Int?
  wardNurseSignatureId        String? // SignatureBlob FK
  otReceivingNurseName        String?
  otReceivingNurseSignedAt    DateTime?
  otReceivingNurseSignedById  Int?
  otReceivingNurseSignatureId String? // SignatureBlob FK

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?

  @@index([scheduleId])
  @@index([status])
}

// COP.14.e — Operative note (must exist before PACU transfer)
// Phase 9.1c — 1:N per schedule (was 1:1). One operative note per surgery
// in a multi-surgery session. Backward compatibility: default noteNumber=1
// keeps the legacy "single note per schedule" behaviour intact.
model OtIntraOpNote {
  id         String     @id @default(uuid())
  scheduleId String
  schedule   OtSchedule @relation(name: "ScheduleToIntraOp", fields: [scheduleId], references: [id], onDelete: Cascade)

  // Phase 9.1c — note ordinal + optional source template (UHJ/OTS/F-03)
  noteNumber Int                    @default(1)
  templateId String?
  template   SurgicalNotesTemplate? @relation(fields: [templateId], references: [id])

  startAt         DateTime
  endAt           DateTime?
  anaesthesiaType String? // GA | regional | local | sedation
  surgeons        String? // comma-sep names — joinable to User if needed
  findings        String?   @db.LongText
  procedureDone   String?   @db.LongText
  bloodLossMl     Int?
  fluidsMl        Int?
  complications   String?   @db.LongText

  // Implants used (MOM.10.d traceability) — JSON array of {batch, serial, name, manufacturer}
  implants String? @db.LongText

  // Phase 9.1c — Operative Note (UHJ/OTS/F-03) additional fields
  caseType                      String? // 'emergency' | 'routine' | 'unplanned-return'
  assistants                    String? // JSON array of { name, role }
  preOpDiagnosis                String?   @db.Text
  postOpDiagnosis               String?   @db.Text
  postOpDiagnosisSame           Boolean   @default(false)
  materialToLabHpe              String?
  materialToLabCis              String?
  materialToLabOthers           String?   @db.Text
  materialToSecurityMlc         String?   @db.Text
  drains                        String?   @db.Text
  prosthesisLabel               String?   @db.Text
  significantIntraOpEvent       String?   @db.LongText
  position                      String?
  incision                      String?   @db.Text
  procedureSteps                String?   @db.LongText
  incisionAt                    DateTime?
  woundClosureAt                DateTime?
  woundClosureDone              Boolean   @default(false)
  skinClosureDone               Boolean   @default(false)
  spongeInstrumentCountVerified Boolean   @default(false)
  disposition                   String? // 'icu' | 'patient-room' | 'home'

  signedAt    DateTime?
  signedBy    String?
  signedById  Int?
  signatureId String? // SignatureBlob FK — primary surgeon

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, noteNumber])
  @@index([scheduleId])
  @@index([templateId])
}

// COP.13.e — Anaesthesia monitoring chart (append-only entries)
model OtAnaesthesiaChart {
  id         String     @id @default(uuid())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  timestamp    DateTime @default(now())
  hr           Int? // heart rate
  sbp          Int? // systolic
  dbp          Int? // diastolic
  spo2         Int? // SpO2 %
  etco2        Int? // EtCO2
  drugs        String?  @db.Text // free-text or JSON of drug pushes at this timestamp
  fluids       String?  @db.Text
  remarks      String?  @db.Text
  recordedBy   String? // anaesthesiologist / nurse name
  recordedById Int?

  // No updatedAt — append-only by design (NABH COP.13.e).

  @@index([scheduleId, timestamp])
}

// PACU recovery record
model PacuRecord {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToPacu", fields: [scheduleId], references: [id], onDelete: Cascade)

  arrivalAt          DateTime?
  dischargedAt       DateTime?
  dischargedTo       String? // 'ward' | 'icu' | 'home' | 'expired'
  dischargedToWardId String?
  dischargedToBedId  String?

  // Initial vitals on arrival
  arrivalHr   Int?
  arrivalSbp  Int?
  arrivalDbp  Int?
  arrivalSpo2 Int?
  arrivalRr   Int?
  arrivalTemp Float?
  arrivalGcs  Int?

  // Pain & criteria
  painScore         Int? // 0..10
  // Aldrete / modified-Aldrete style criteria — store as JSON
  dischargeCriteria String? @db.Text

  // Sign-off
  dischargeCriteriaMet Boolean @default(false)
  signedBy             String?
  signedById           Int?
  signatureId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vitals PacuVital[]

  @@index([scheduleId])
}

// PACU vitals — append-only every 15 mins until discharge from PACU.
model PacuVital {
  id           String     @id @default(uuid())
  pacuRecordId String
  pacu         PacuRecord @relation(fields: [pacuRecordId], references: [id], onDelete: Cascade)

  timestamp  DateTime @default(now())
  hr         Int?
  sbp        Int?
  dbp        Int?
  spo2       Int?
  rr         Int?
  temp       Float?
  painScore  Int?
  recordedBy String?

  @@index([pacuRecordId, timestamp])
}

// Outcomes — feeds PSQ.3.a (return-to-OT) and PSQ.3.b (SSI) KPIs.
model OtOutcome {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToOutcome", fields: [scheduleId], references: [id], onDelete: Cascade)

  // Was this an unplanned return to OT for an earlier surgery? If yes,
  // `linkedScheduleId` points back at the original schedule.
  unplannedReturn  Boolean @default(false)
  linkedScheduleId String?

  // SSI = surgical site infection. Set within 30 days post-op via
  // either nurse observation or lab culture.
  surgicalSiteInfection Boolean   @default(false)
  ssiDetectedAt         DateTime?
  ssiOrganism           String?
  ssiClassification     String? // superficial | deep | organ-space

  // Final outcome
  mortality        Boolean @default(false)
  mortalityCause   String?
  lengthOfStayDays Int?
  followUpNotes    String? @db.LongText

  recordedAt   DateTime @default(now())
  recordedBy   String?
  recordedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([surgicalSiteInfection])
  @@index([unplannedReturn])
}

model NabhAuditExport {
  id String @id @default(uuid())

  scope    String // 'full' | 'wf-1' | 'wf-2' | 'wf-3' | 'wf-4' | 'wf-5' | 'incident' | 'hmis'
  fromDate DateTime
  toDate   DateTime

  status String @default("QUEUED") // QUEUED | PROCESSING | READY | FAILED

  // Output
  filePath    String?
  downloadUrl String?
  rowCount    Int?
  bundleBytes Int?

  errorDetail String? @db.LongText

  // Originator
  requestedBy   String?
  requestedById Int?

  // Timestamps
  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([scope])
  @@index([requestedAt])
}

model HmisConflict {
  id Int @id @default(autoincrement())

  module     String // patient | ipd | lab | …
  entityType String // 'patient' | 'admission' | …
  entityId   String // PRN / admission id / etc. (string for compatibility)
  fieldName  String // 'name' | 'phone' | 'diagnosis' …

  localValue String? @db.LongText
  hmisValue  String? @db.LongText

  detectedAt DateTime @default(now())

  // ─── Resolution ──────────────────────────────────────────────────────
  status       String    @default("OPEN") // OPEN | RESOLVED_LOCAL | RESOLVED_HMIS | IGNORED
  resolution   String?   @db.Text // who/why
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedById Int?

  // Cross-link back to the audit log row that surfaced the conflict.
  triggerAuditLogId Int?

  @@index([status])
  @@index([module])
  @@index([entityType, entityId])
  @@index([detectedAt])
}

model InvestigationResult {
  id             Int                @id @default(autoincrement())
  orderId        Int
  order          InvestigationOrder @relation(fields: [orderId], references: [id])
  prn            String
  testName       String
  department     String // lab | radiology
  result         String?            @db.LongText
  unit           String?
  referenceRange String?
  criticalFlag   Boolean            @default(false)
  reportUrl      String? // GCS URL of report PDF
  reportedAt     DateTime?
  hmisResultId   String?
  status         String // pending | partial | final

  // Phase 9.11 — radiology bodies (findings/impression are radiology
  // conventions; lab can leave them null and use `result` instead).
  findings   String? @db.Text
  impression String? @db.Text

  // Phase 9.11 — provenance (who uploaded), critical-result ack (who saw it
  // first), and soft-delete flag so audit trail survives bad uploads.
  uploadedBy       String?
  uploadedById     Int?
  uploadedAt       DateTime?
  acknowledgedBy   String?
  acknowledgedById Int?
  acknowledgedAt   DateTime?
  isDeleted        Boolean   @default(false)

  // Phase 9.11 (Phase B) — third-party feed provenance. `webhookProvider`
  // is the vendor key (e.g. 'manorama-lab', 'kims-rad'); `hmisResultId`
  // is the vendor's external ID, used to dedupe re-deliveries. Together
  // they're the upsert key for the webhook ingest path.
  webhookProvider String?

  createdAt DateTime @default(now())
  // `@default(now())` is required so the migration can back-fill the four
  // existing InvestigationResult rows that pre-date Phase 9.11. After the
  // initial insert, `@updatedAt` continues to bump it on every write.
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([webhookProvider, hmisResultId], name: "providerResultUnique")
  @@index([prn])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([criticalFlag, acknowledgedAt])
  @@index([department])
  @@index([isDeleted])
}

// IPD Ward Management
model IpdWard {
  id         String   @id @default(uuid())
  wardName   String
  wardCode   String   @unique
  floor      String?
  department String
  totalBeds  Int
  hmisWardId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admissions       IpdAdmission[]
  beds             IpdBed[]
  shiftAssignments StaffShiftAssignment[]
  // Phase 9.10 — back-relation for User.primaryWardId (nurse home ward).
  primaryNurses    User[]                 @relation(name: "UserPrimaryWard")
  // Nursing Stations (Phase NS-1) — stations this ward belongs to (m:n).
  stationLinks     NursingStationWard[]

  @@index([wardCode])
  @@index([department])
}

model IpdBed {
  id         String   @id @default(uuid())
  bedNumber  String
  wardId     String
  bedType    String // general | ICU | HDU | isolation
  status     String   @default("available") // available | occupied | maintenance | reserved
  hmisBedrId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ward       IpdWard        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions IpdAdmission[]

  @@unique([wardId, bedNumber])
  @@index([wardId])
  @@index([status])
}

// IPD Admission
model IpdAdmission {
  id                  String   @id @default(uuid())
  admissionNo         String   @unique
  prn                 String
  admissionDate       DateTime
  admissionTime       String
  admissionType       String // elective | emergency | transfer
  sourceModule        String // opd | emergency | direct
  referralOpdId       String?
  referralEmergencyId String?
  referralMlcId       String?
  referralEstimationId String? // set when admission proposed from a confirmed estimation
  referringDoctor     String?
  admittingDoctor     String
  department          String
  // Phase 3 — wardId/bedId are nullable to support PROPOSED state (bed not
  // yet assigned). Once status flips to BED_ACCEPTED or 'admitted', both
  // are required by application-level guards.
  wardId              String?
  bedId               String?
  roomType            String // general | semi-private | private | ICU | HDU
  diagnosis           String   @db.LongText
  // Phase 3 — extended status flow (WF-2 handshake).
  // Pre-existing values "admitted | transferred | discharged | LAMA | DAMA | expired"
  // continue to work. New pre-admission states:
  //   PROPOSED — doctor referred, bed not yet requested
  //   BED_REQUESTED — request raised to nursing station
  //   BED_ACCEPTED — NS accepted, awaiting bedside consent + facility acceptance
  //   admitted — handshake closed; patient occupies the bed
  status              String   @default("PROPOSED")
  hmisAdmissionId     String?
  hmisTransferId      String?

  // Phase 3 — handshake artefact snapshots (FKs to SignatureBlob).
  nsAcceptanceSignatureId               String? // NS nurse signs "bed ready, equipment verified"
  attenderFacilityAcceptanceSignatureId String? // attender signs "facility accepted at bedside"
  consentSignatureIds                   String? @db.Text // JSON array of ConsentSignature ids tied to this admission

  // Phase 9.13 — doctor-ordered vitals monitoring frequency. Set at the
  // initial assessment and re-orderable from a progress note. Drives the
  // Treatment Dashboard "vitals overdue" check (doctor order wins over the
  // acuity-band default). Values: 'continuous'|'1h'|'2h'|'4h'|'6h'|'8h'|
  // '12h'|'bd'.
  vitalsMonitoringFrequency String?
  vitalsMonitoringSetBy     String?
  vitalsMonitoringSetAt     DateTime?

  // Phase 9.18 — doctor-ordered glucose/insulin monitoring cadence. Same
  // shape as the vitals order above, but a glucose-specific cadence set
  // (QID / pre-meal are standard for sliding-scale insulin). Drives the
  // "glucose check overdue" indicator on the Insulin Infusion Chart.
  // Values: 'continuous'|'1h'|'2h'|'4h'|'6h'|'8h'|'qid'|'bd'|'premeal'.
  glucoseMonitoringFrequency String?
  glucoseMonitoringSetBy     String?
  glucoseMonitoringSetAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  bed               IpdBed?                  @relation(fields: [bedId], references: [id])
  ward              IpdWard?                 @relation(fields: [wardId], references: [id])
  progressNotes     IpdProgressNote[]
  discharge         IpdDischarge?
  prescriptions     IpdPrescription[]
  bedRequests       IpdBedRequest[]
  dailyClosures     IpdDailyClosure[] // Phase 4 (WF-3)
  icuTransfers      IpdIcuTransferRequest[] // Phase 5 (WF-4)
  initialAssessment IpdInitialAssessment? // Phase 1 — adult admission assessment form
  vitalsReadings    IpdVitalsReading[] // Phase 2 — per-slot clinical chart vitals
  intakeOutput      IpdIntakeOutputEntry[] // Phase 2 — per-event I/O log
  dailyCharts       IpdDailyChart[] // Phase 2 — per-day rollup row
  handovers         IpdHandover[] // Phase 3 — per-shift SBAR handover
  nonDrugOrders     IpdNonDrugOrder[] // Phase 7 — non-drug doctor orders
  diagnosisCodes    AdmissionDiagnosisCode[] // Phase 9.3c — ICD-10 + CPT codes

  // Phase 9.6 — ICU stay tracking. Set when the ICU transfer COMPLETES
  // (patient physically arrives at the ICU bed). Cleared / icuDischargedAt
  // set when step-down completes. priorIcuDischargeAt remembers the prior
  // ICU discharge timestamp for 30-day-readmission flagging.
  icuAdmittedAt       DateTime?
  icuDischargedAt     DateTime?
  priorIcuDischargeAt DateTime?

  // Phase 9.6 — back-relations to ICU clinical artefacts
  icuVitals           IcuVitalsReading[]
  icuProgressNotes    IcuProgressNote[]
  icuSedationLogs     IcuSedationLog[]
  icuRestraintLogs    IcuRestraintLog[]
  icuBundleLogs       IcuBundleLog[]
  icuFamilyComms      IcuFamilyCommunication[]
  icuStepDownRequests IcuStepDownRequest[]

  // Phase 9.13 — Treatment Dashboard (NEWS2 acuity)
  acuitySnapshots   PatientAcuitySnapshot[]
  acuityEscalations AcuityEscalation[]

  // Phase 9.14 — Insulin Infusion Chart
  insulinInfusions  IpdInsulinInfusion[]

  // Phase 9.16 — ICU Nurses Care Record
  icuInvasiveLines  IcuInvasiveLine[]
  icuNursingCarePlans IcuNursingCarePlan[]
  icuNurseNotes     IcuNurseNote[]

  // ─── Phase D — Discharge clearance chain ─────────────────────────────
  // dischargeReadyAt: ward doctor flips this when the patient is clinically
  // ready to discharge. Triggers MT queue + diet/billing pre-notify. The
  // discharge summary is then drafted/signed, and at sign-time we spawn the
  // parallel DischargeClearance rows. dischargeChainAbandoned skips the
  // chain entirely for LAMA / DAMA cases.
  dischargeReadyAt              DateTime?
  dischargeReadyBy              String?
  dischargeReadyById            Int?
  dischargeChainAbandoned       Boolean   @default(false)
  dischargeChainAbandonedReason String?   @db.Text
  dischargeChainAbandonedAt     DateTime?
  dischargeChainAbandonedBy     String?
  dischargeClearances           DischargeClearance[]

  // LAMA/DAMA for IPD / post-op admitted patients (alt link to Emergency-sourced records)
  lamaRecords LamaRecord[] @relation("IpdAdmissionLamaRecords")
  damaRecords DamaRecord[] @relation("IpdAdmissionDamaRecords")

  @@index([prn])
  @@index([admissionNo])
  @@index([wardId])
  @@index([bedId])
  @@index([status])
  @@index([admissionDate])
  @@index([icuAdmittedAt])
}

// Phase 9.14 — Insulin Infusion Chart (UHJ paper form).
//
// Per-admission time-series of blood glucose + insulin infusion rate, one
// row per reading. Doctor + nurse are always captured by name (fast entry);
// an e-signature per row is optional (SignatureBlob FK) for formal sign-off.
model IpdInsulinInfusion {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt       DateTime
  bloodGlucoseMgDl Int?
  // Free text — the paper's "Insulin in U/hour" column is free-form:
  // "H. Actrapid 1.5 ml/hr on flow", "Inj Piasp 12 units", "Inj Tresiba".
  insulinOrder     String?  @db.Text

  doctorName        String?
  doctorSignatureId String? // SignatureBlob FK — optional e-sign
  nurseName         String?
  nurseSignatureId  String? // SignatureBlob FK — optional e-sign

  remarks String? @db.Text

  recordedBy   String?
  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([admissionId, recordedAt])
}

// Phase 9.4d — OP Procedures (outpatient minor procedure flow).
//
// Distinct from the major OT schedule. Used for in-clinic minor
// procedures: suturing, dressing change, plaster, abscess I&D, bedside
// endoscopy, etc. Patient context is typically an OPD visit or a
// walk-in; no admission required, no requisition queue, no multi-
// signature chain. One procedure = one row.
//
// Lifecycle: SCHEDULED → IN_PROGRESS → COMPLETED (or CANCELLED).
model OpProcedure {
  id          String @id @default(uuid())
  procedureNo String @unique // human-readable e.g. JMRH-OP-PROC-2026-0001

  // Patient context (snapshot)
  prn         String
  patientName String
  age         Int?
  gender      String?
  phoneNumber String?

  // Source — either linked to an OPD appointment or freestanding
  opdAppointmentId Int?
  sourceModule     String @default("opd") // 'opd' | 'walk-in' | 'er'

  // Procedure details
  procedureName      String
  procedureCode      String?
  departmentId       Int?
  departmentName     String?
  performingDoctor   String
  performingDoctorId Int?
  assistantName      String?
  roomName           String? // procedure room number / name

  // Anaesthesia (minor only)
  anaesthesiaType  String? // 'local' | 'topical' | 'sedation' | 'none'
  anaesthesiaAgent String?

  // Timing
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // Clinical narrative
  preProcedureNotes String? @db.Text
  procedureSteps    String? @db.LongText
  findings          String? @db.LongText
  complications     String? @db.Text

  // Disposition
  conditionAtEnd            String? // 'stable' | 'fair' | 'critical'
  disposition               String? // 'home' | 'observation' | 'admit'
  postProcedureInstructions String? @db.Text

  // Sign-off
  signedBy    String?
  signedById  Int?
  signatureId String?
  signedAt    DateTime?

  // Lifecycle
  status       String  @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  cancelReason String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  @@index([prn])
  @@index([scheduledAt])
  @@index([status])
  @@index([opdAppointmentId])
}

// Phase 9.4c — Per-role surgery billing lines on an estimation.
//
// Mirrors the reference HMIS "Order Surgeries" screen: one line per
// service rendered by a specific staff role (Surgeon / Co-Surgeon /
// Anaesthetist / Assistant Surgeon) with rate + discount + adjustment.
// Lines are scoped by `estimationId` (EstimationDetails.estimationId,
// a String @unique). No formal Prisma relation — matches the loose
// linkage pattern OtSchedule.estimationId already uses.
model EstimationSurgeryLine {
  id           Int    @id @default(autoincrement())
  estimationId String // FK target: EstimationDetails.estimationId

  // Surgery context (denormalised — survives renames)
  surgeryName    String
  departmentName String?
  categoryCode   String?

  // Role + service catalog item
  role        String // 'surgeon' | 'co-surgeon' | 'assistant-surgeon' | 'anaesthetist' | 'ot-rent' | 'other'
  serviceCode String?
  serviceName String
  renderedBy  String? // doctor name snapshot

  // Billing components
  rate             Float   @default(0)
  quantity         Int     @default(1)
  discountPercent  Float   @default(0)
  discountReason   String? @db.Text
  adjustmentAmount Float   @default(0)
  adjustmentReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([estimationId])
  @@index([role])
}

// Phase 9.5e — OT Equipment master (admin-curated list).
//
// Per-schedule OtEquipmentUsage rows snapshot a name; this master drives
// the picker dropdown and lets admins keep the equipment catalog in sync
// with what's actually on the OT floor. Renaming here does not retro-
// actively change historical usage rows.
model OtEquipmentMaster {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String? @unique // optional asset/inventory ref
  category    String? // 'imaging' | 'monitoring' | 'surgical' | 'anaesthesia' | 'other'
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([category])
  @@index([isActive])
}

// Phase 9.5j — OT Staff master (non-doctor clinical staff).
//
// The Doctor table only covers doctors. OT and procedure rooms need to
// roster nurses, technicians, runners, anaesthesia techs etc. by name —
// this master is the source of truth for those dropdowns.
//
// Reference: scrub nurse, floor nurse, runner, OR technician, anaesthesia
// technician, CSSD technician, biomedical technician, etc.
model OtStaffMaster {
  id           Int     @id @default(autoincrement())
  name         String
  employeeCode String? @unique // optional HR/employee ref
  // 'scrub-nurse' | 'floor-nurse' | 'runner' | 'ot-technician' |
  // 'anaesthesia-technician' | 'cssd' | 'biomedical' | 'other'
  role         String
  designation  String? // free-text job title shown after name
  departmentId Int?
  isActive     Boolean @default(true)

  // Phase 9.10 — optional link back to User. When an OT staff row is created
  // from a nurse User on /staff/nurses (sub-admin=nurse), userId points to
  // that account. Existing OT-only rows (no login) stay with userId=NULL.
  userId Int?
  user   User? @relation(name: "UserOtStaff", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([role])
  @@index([departmentId])
  @@index([isActive])
  @@index([name])
  @@index([userId])
}

// Phase 9.5j — Surgery / procedure catalog master.
//
// Drives the surgery-name dropdown in ot-schedule-extras (multi-surgery
// per schedule) and order-surgeries (billing lines). Mirrors the
// reference HMIS "Enter Surgery" dialog which scopes surgeries by
// Department + Category (e.g. "Orthopedics · Level 4A · (RT) TKR").
//
// `categoryCode` is denormalised into OtScheduleSurgery + EstimationSurgeryLine
// at write-time so a renamed master never silently rewrites historical rows.
model SurgeryProcedureMaster {
  id           Int     @id @default(autoincrement())
  name         String
  code         String? @unique
  departmentId Int?
  // Free-text category — e.g. "Level 4A", "Major", "Minor"; matches
  // the reference HMIS surgery-category field.
  categoryCode String?
  // Default surgery type — 'Invasive' | 'Minimally Invasive' | 'Non-Invasive' | 'Diagnostic'
  surgeryType  String?
  description  String? @db.Text
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([departmentId])
  @@index([categoryCode])
  @@index([isActive])
  @@index([name])
}

// Phase 9.5e — Fixed Surgical Notes master ("Fix Surgical Notes" admin item).
//
// Distinct from SurgicalNotesTemplate (which is reusable rich-text
// boilerplate): this catalog drives the dropdown of pre-set, fixed surgical
// note categories the hospital wants to standardise on (e.g. "Standard
// Appendectomy Closure", "Knee Replacement — Cemented", "Caesarean Section
// — LSCS"). Surgeons pick one to anchor their operative note; the body
// field is treated as default/example text.
model FixedSurgicalNote {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  departmentId Int?
  body         String  @db.LongText
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([departmentId])
  @@index([isActive])
}

// Phase 9.5a — Emergency Surgery Charges (Emrg Surgery Charges in reference HMIS).
//
// Applied as a surcharge against an OT schedule whose urgency='emergency'.
// The reference HMIS lets billing pick from named surcharge reasons
// (after-hours / weekend / holiday / staff-callback / equipment-setup) with
// a flat amount or % of surgery total, plus optional manual override. One
// schedule can carry multiple surcharge rows (e.g. after-hours + holiday).
model EmrgSurgerySurcharge {
  id         String     @id @default(uuid())
  scheduleId String
  schedule   OtSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  surchargeType String // 'after-hours' | 'weekend' | 'holiday' | 'staff-callback' | 'equipment-setup' | 'custom'
  reason        String? @db.Text
  baseAmount    Float   @default(0) // surgery total at the time of computation (snapshot)
  percent       Float   @default(0) // % of baseAmount; 0 if flat
  flatAmount    Float   @default(0) // flat surcharge in INR; 0 if percent
  totalAmount   Float   @default(0) // computed total = (baseAmount * percent / 100) + flatAmount

  appliedToEstimation Boolean @default(false) // true once posted as an EstimationSurgeryLine
  estimationLineId    Int? // FK back to the posted line (if applied)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  @@index([scheduleId])
  @@index([surchargeType])
}

// Phase 9.4a — ICD-10 + CPT master catalog for autocomplete.
//
// Hospital MRD team curates this list. AdmissionDiagnosisCode rows
// store a denormalised snapshot of code+description so a renamed
// master never silently mutates historical records.
model DiagnosisCodeMaster {
  id          Int     @id @default(autoincrement())
  category    String // 'icd' | 'cpt' — ICD covers both provisional/final, CPT separately
  code        String
  description String  @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([category, code])
  @@index([category])
  @@index([code])
}

// Phase 9.3c — ICD-10 + CPT codes per admission (MRD coding).
//
// Three categories stored in one table to keep CRUD trivial:
//   icd-provisional — admitting diagnoses (entered at admission)
//   icd-final       — discharge diagnoses (entered at discharge)
//   cpt             — procedure codes (CPT-4 / ICD-PCS, entered at discharge)
//
// Mirrors the reference HMIS "Update Patient's Diagnosis" screen with ICD
// Codes + CPT Codes + Provisional / Final tabs.
model AdmissionDiagnosisCode {
  id          String @id @default(uuid())
  admissionId String
  category    String // 'icd-provisional' | 'icd-final' | 'cpt'
  code        String
  description String @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([category])
  @@index([admissionId, category])
}

// IPD Progress Notes (SOAP)
model IpdProgressNote {
  id           String    @id @default(uuid())
  admissionId  String
  date         DateTime  @default(now())
  doctorName   String
  subjective   String    @db.LongText // SOAP
  objective    String    @db.LongText
  assessment   String    @db.LongText
  plan         String    @db.LongText
  nursingNotes String?   @db.LongText
  vitalsBP     String?
  vitalsHR     String?
  vitalsTemp   String?
  vitalsSpO2   String?
  vitalsRR     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt // Sprint 4a — MRD.1 timestamp gap-fill
  createdBy    String?
  createdById  Int? // Sprint 4a — MRD audit typed creator
  updatedBy    String? // Sprint 4b — MRD audit username updater
  updatedById  Int? // Sprint 4b — MRD audit typed updater

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([date])
}

// IPD Discharge Summary
model IpdDischarge {
  id                   String    @id @default(uuid())
  admissionId          String    @unique
  dischargeDate        DateTime
  dischargeTime        String
  dischargeType        String // regular | LAMA | transfer | expired
  finalDiagnosis       String    @db.LongText
  proceduresDone       String?   @db.LongText
  conditionAtDischarge String
  dischargeSummary     String    @db.LongText
  followUpDate         DateTime?
  followUpDoctor       String?
  medications          String    @db.LongText // JSON array
  advice               String?   @db.LongText
  doctorSignature      String? // Sprint 4a — NABH MRD.3 (legacy free-text)
  hmisDischargeId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt // Sprint 4a — MRD.1 timestamp gap-fill
  createdBy            String?
  createdById          Int? // Sprint 4a — MRD audit typed creator
  updatedBy            String? // Sprint 4b — MRD audit username updater
  updatedById          Int? // Sprint 4b — MRD audit typed updater

  // ─── Phase 6 (WF-5) — AI-drafted discharge summary + sign-off chain ───
  // Lifecycle:
  //   NONE     — row was created via the legacy free-text path, no AI draft
  //   DRAFTED  — AI returned a structured draft; clinician hasn't reviewed yet
  //   EDITED   — clinician modified at least one field; aiDraftJson preserved
  //   SIGNED   — clinician e-signed (clinicianSignatureId set); locks edits
  //   DELIVERED — attender acknowledged receipt of the printed summary
  //
  // Phase D — Medical transcriptionist acknowledgement. After the ward doctor
  // toggles "ready for discharge" (IpdAdmission.dischargeReadyAt), this row
  // appears in the MT queue. MT acks to claim it, then drafts → doctor edits
  // → doctor signs. mtAcknowledgedAt is what lets the nag cron know the case
  // is being worked on, separate from whether it's been signed yet.
  mtAcknowledgedAt   DateTime?
  mtAcknowledgedBy   String?
  mtAcknowledgedById Int?

  summaryStatus                     String    @default("NONE")
  aiDraftJson                       String?   @db.LongText // raw structured draft from the model
  aiDraftedAt                       DateTime?
  aiDraftedByModel                  String? // e.g. "gpt-4o-mini"
  clinicianSignatureId              String? // FK to SignatureBlob — locks the row
  clinicianSignedAt                 DateTime?
  clinicianSignedBy                 String? // doctor name snapshot
  clinicianSignedById               Int?
  attenderAcknowledgmentSignatureId String? // FK to SignatureBlob
  attenderAcknowledgedAt            DateTime?
  attenderName                      String?
  attenderRelation                  String?

  // Department-scoped templates (optional). When set, the discharge form
  // and PDF render the template's fields instead of the legacy free-text
  // columns above. Snapshot at sign time: `templatedValues` stores
  // `{_schema: [...frozen fields], _values: {key: value}}`. Future edits to
  // the live NoteTemplate row never affect signed discharges (NABH-safe).
  noteTemplateId  String?
  templatedValues String? @db.LongText

  // Phase 9.6 — ICU stay section. Populated when the admission had any
  // ICU exposure (icuAdmittedAt set at some point). `icuOutcome` summarises
  // the ICU course; intensivistSignatureId is a second sign-off required
  // by NABH COP.3 in addition to the ward clinician signature.
  icuStay                Boolean   @default(false)
  icuDays                Int?
  icuOutcome             String? // 'recovered' | 'stepped-down' | 'transferred-out' | 'expired'
  icuSummary             String?   @db.LongText
  intensivistSignedAt    DateTime?
  intensivistSignedBy    String?
  intensivistSignedById  Int?
  intensivistSignatureId String?

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([dischargeDate])
  @@index([summaryStatus])
  @@index([noteTemplateId])
}

// ─── Phase D — Discharge clearance chain ─────────────────────────────────
//
// One row per (admissionId, department). Spawned in parallel at the moment
// the ward doctor signs the discharge summary (IpdDischarge.summaryStatus
// flips to 'SIGNED'). Each row is owned by that department's coordinator
// role; finalising the discharge requires every row to reach 'cleared'.
//
// Departments:
//   OT       — only spawned when the admission has any OtSchedule row
//   BILLING  — always
//   NURSING  — always
//   PHARMACY — always (returns / final dispense reconciliation)
//   LAB_RAD  — always (pending sample / pending report check)
//   DIET     — always (stop trays + nutrition discharge counselling)
//   MLC      — only when the admission is an MLC case
//
// blockingReason / rejectedAt let a department push back ("pending charges",
// "stat report awaited") so the discharge board surfaces the actual blocker
// instead of an opaque pending state.
model DischargeClearance {
  id           String   @id @default(uuid())
  admissionId  String
  department   String // 'OT' | 'BILLING' | 'NURSING' | 'PHARMACY' | 'LAB_RAD' | 'DIET' | 'MLC'
  status       String   @default("pending") // 'pending' | 'cleared' | 'rejected'

  blockingReason String? @db.Text
  rejectedAt     DateTime?
  rejectedBy     String?
  rejectedById   Int?

  clearedAt          DateTime?
  clearedBy          String?
  clearedById        Int?
  clearedNotes       String?  @db.Text
  clearedSignatureId String?  // FK-by-id to SignatureBlob (optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([admissionId, department])
  @@index([status])
  @@index([department, status])
}

// IPD Prescriptions (with carry-over from OPD/Emergency)
model IpdPrescription {
  id             String   @id @default(uuid())
  admissionId    String
  prescriptionId String? // Link to original OPD/Emergency prescription
  prescribedBy   String
  prescribedDate DateTime @default(now())
  carryOverFrom  String? // opd | emergency (source module if carryover)

  // Drug details
  genericName  String
  brandName    String?
  dose         String
  frequency    String
  duration     String
  route        String  @default("oral") // oral | iv | im | topical | sc | id
  // Form 3 (Phase 8) — injection / patch site (NABH MOM.3 injection safety).
  // For IM / SC / transdermal routes the nurse logs the specific body location
  // ("left deltoid", "right gluteal", "upper arm") so site rotation can be
  // audited. Free text — pharmacy team picks site nomenclature.
  site         String?
  instructions String?
  quantity     Int

  // IPD-specific fields
  isCarryOver        Boolean   @default(false)
  lastAdminTime      DateTime?
  nextAdminTime      DateTime?
  adminStatus        String // pending | administered | skipped | stopped
  status             String    @default("active") // active | paused | discontinued
  modificationReason String? // Sprint 4a — NABH MOM.4
  hmisRxId           String?

  // Phase 4a — Medication reconciliation (NABH MOM.1.c / IPSG.3).
  // Captured at admission when the home medications are reviewed against
  // what the inpatient team intends to prescribe. The printed form lists
  // each home med and forces a decision per row.
  //
  // prescriptionType — distinguishes STAT / VARIABLE (sliding-scale insulin,
  // heparin) / REGULAR. Drives MAR display + alerting.
  prescriptionType     String? // 'STAT' | 'VARIABLE' | 'REGULAR' | null (legacy)
  reconciliationAction String? // 'CONTINUE' | 'CHANGE' | 'HOLD' | 'DISCONTINUE' | 'RECONCILE'
  reconciliationReason String?   @db.Text
  reconciledAt         DateTime?
  reconciledBy         String?
  reconciledById       Int?

  // ─── Phase P — Pharmacy + nurse handshake ───────────────────────────
  // Pharmacy handshake lifecycle:
  //   sentToPharmacyAt → pharmacyAckAt → dispensedAt → nurseCollectedAt
  //   (any of pharmacyRejected*, nurseReturn* break the chain and return
  //   the script to the prior actor with a typed reason)
  //
  // STAT prescriptions skip the ack queue (isStatBypass=true) and page the
  // on-call pharmacist directly via in-app notification.
  // dispensedQty supports partial dispense (e.g. 2 of 5 strips) — nurses
  // ack per remaining-quantity so the doctor view shows true outstanding.
  sentToPharmacyAt        DateTime?
  isStatBypass            Boolean   @default(false)
  pharmacyAckAt           DateTime?
  pharmacyAckBy           String?
  pharmacyAckById         Int?
  pharmacyRejectedAt      DateTime?
  pharmacyRejectedBy      String?
  pharmacyRejectedById    Int?
  pharmacyRejectedReason  String?   @db.Text
  dispensedAt             DateTime?
  dispensedBy             String?
  dispensedById           Int?
  dispensedQty            Int? // partial dispense: total dispensed so far (<= quantity)
  substitutedBrand        String? // logged when pharmacy fills with a different brand
  substitutedReason       String?   @db.Text
  nurseCollectedAt        DateTime?
  nurseCollectedBy        String?
  nurseCollectedById      Int?
  nurseCollectedQty       Int? // partial: nurse acknowledges only what was actually handed over
  nurseReturnedAt         DateTime?
  nurseReturnedBy         String?
  nurseReturnedById       Int?
  nurseReturnReason       String?   @db.Text
  // HMIS stock probe — captured at save time so we know what the doctor saw.
  // stockProbeJson is the raw probe response (qty available + brand list);
  // stockProbeAt lets us flag the probe as stale on later display.
  stockProbeJson          String?   @db.Text
  stockProbeAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?
  createdById          Int? // Sprint 4a — MRD audit typed creator
  updatedById          Int? // Sprint 4b — MRD audit typed updater

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([status])
  @@index([adminStatus])
}

// IPD Medication Administration Record (MAR)
model IpdMedicationLog {
  id             String    @id @default(uuid())
  prescriptionId String
  admissionId    String
  administeredAt DateTime  @default(now())
  administeredBy String // Nursing staff name
  quantity       Int
  route          String
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt // Sprint 4a — MRD.1 timestamp gap-fill
  createdById    Int? // Sprint 4a — MRD audit typed creator
  updatedBy      String? // Sprint 4b — MRD audit username updater
  updatedById    Int? // Sprint 4b — MRD audit typed updater

  // Phase 4 (WF-3) — MAR acknowledgement chain.
  // Two-identifier check + 5-rights gating before administration is recorded
  // as final. Co-signature/witness signature for high-risk meds is captured
  // in `acknowledgedBySignatureId`.
  verifiedTwoIdentifiers    Boolean   @default(false)
  fiveRightsChecked         Boolean   @default(false)
  acknowledgedBy            String? // co-signer / witness name
  acknowledgedById          Int?
  acknowledgedAt            DateTime?
  acknowledgedBySignatureId String? // SignatureBlob FK

  @@index([prescriptionId])
  @@index([admissionId])
  @@index([administeredAt])
}

// ============================================================================
// PHASE 4 — IPD DAILY CLOSURE (WF-3 daily care + attender ack)
// One row per (admissionId, closureDate). The bedside-attender closure form
// captures: doctor visit time, nursing summary, attender satisfaction,
// negative-flag detection, and an attender signature acknowledging the day.
// Reception cron creates one open row per occupied admission each morning;
// closure is locked when the attender signs.
// ============================================================================
model IpdDailyClosure {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id])

  closureDate DateTime // start-of-day (midnight) for the day this closure covers

  // ─── Care snapshot ───────────────────────────────────────────────────
  doctorVisitedAt DateTime? // when the consultant/registrar saw the patient
  doctorVisitedBy String? // doctor name snapshot
  nursingSummary  String?   @db.Text // free-text summary of the day's care
  vitalsSummary   String?   @db.Text // morning/evening vitals digest

  // ─── Attender feedback (WF-3 §C, NABH PSQ.5) ─────────────────────────
  satisfactionScore Int? // 1..5 likert
  concerns          String? @db.Text
  negativeFlag      Boolean @default(false) // auto-set when score≤2 OR concerns non-empty

  // ─── Closure / acknowledgement chain ─────────────────────────────────
  status                   String    @default("OPEN") // OPEN | CLOSED
  attenderName             String?
  attenderRelation         String?
  attenderSignatureId      String? // SignatureBlob FK — locks the row
  closedAt                 DateTime?
  closedBy                 String? // nurse / staff name who walked attender through
  closedById               Int?
  escalationOpenedTicketId String? // when negativeFlag triggers PSQ ticket

  // ─── System ──────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([admissionId, closureDate])
  @@index([closureDate])
  @@index([status])
  @@index([negativeFlag])
}

// ============================================================================
// PHASE 5 — IPD ICU TRANSFER (WF-4)
// Three-signature chain — originator (proposing doctor), supervisor
// (intensivist), receiver (ICU charge nurse). Status flow:
//   PROPOSED → ACKNOWLEDGED → ACCEPTED → IN_TRANSIT → COMPLETED
//                          ↘ DECLINED (with reason; closes the chain)
// Field names match the NABH COP.5 transfer-out checklist (rationale,
// vitals, lines/drains, code-status carry-forward, sedation plan).
// ============================================================================
model IpdIcuTransferRequest {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id])

  // ─── Clinical context (snapshot from the proposing ward) ─────────────
  fromWardId     String?
  fromBedId      String?
  toWardId       String? // ICU ward id, optional at PROPOSED time
  toBedId        String? // assigned at ACCEPTED time
  rationale      String  @db.Text // why the patient needs ICU (NABH COP.5)
  vitalsSnapshot String? @db.Text // BP/HR/SpO2/GCS at the time of proposal
  linesAndDrains String? @db.Text // central line, foley, NG, ETT, etc.
  codeStatus     String? // full-code | DNR | DNI | comfort-care
  sedationPlan   String? @db.Text // who continues, target RASS, etc.

  // ─── Lifecycle ────────────────────────────────────────────────────────
  status String @default("PROPOSED")
  // PROPOSED → ACKNOWLEDGED → ACCEPTED → IN_TRANSIT → COMPLETED
  //          ↘ DECLINED (with reason)

  // ─── Originator (proposing doctor on the ward) ──────────────────────
  proposedAt          DateTime @default(now())
  proposedBy          String? // username snapshot
  proposedById        Int?
  proposerName        String? // doctor display name (joinable, but stored for audit)
  proposerSignatureId String? // SignatureBlob FK

  // ─── Supervisor (intensivist acknowledging acceptability) ────────────
  acknowledgedAt         DateTime?
  acknowledgedBy         String? // username snapshot
  acknowledgedById       Int?
  intensivistName        String?
  intensivistSignatureId String? // SignatureBlob FK
  declineReason          String?   @db.Text

  // ─── Receiver (ICU charge nurse accepting + completing handover) ─────
  acceptedAt          DateTime?
  acceptedBy          String?
  acceptedById        Int?
  receiverSignatureId String? // SignatureBlob FK — accept (bed ready)
  inTransitAt         DateTime?
  completedAt         DateTime?
  handoverSignatureId String? // SignatureBlob FK — completion (patient on bed)

  // ─── System ──────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId])
  @@index([status])
  @@index([proposedAt])
}

// ============================================================================
// PHASE 7 — STAFF HANDOVER / CONTINGENCY REASSIGNMENT
// One row per handover event (NABH HRM.5 / COP.4 / PSQ.6).
//
// `eventType` discriminates four flows that share a signature chain:
//   PLANNED_SHIFT      — routine shift change handover
//   UNPLANNED_ABSENCE  — staff absent unexpectedly; patients reassigned
//   RATIO_BREACH       — nurse:patient ratio exceeded; supervisor must sign
//   DOCTOR_UNAVAILABLE — treating doctor unavailable; cover doctor accepts
//
// Status flow:
//   OPEN → ACKNOWLEDGED → CLOSED
//        ↘ DECLINED (with reason)
//
// `patientsAffected` is a JSON array of `{ admissionId, prn, summary }` so the
// receiver can do a per-patient "I read this" tick without us creating a
// separate row per patient.
// ============================================================================
model StaffHandover {
  id String @id @default(uuid())

  eventType String // PLANNED_SHIFT | UNPLANNED_ABSENCE | RATIO_BREACH | DOCTOR_UNAVAILABLE
  shift     String // morning | evening | night | adhoc

  department String?
  wardId     String?

  // ─── Lifecycle ────────────────────────────────────────────────────────
  status String @default("OPEN") // OPEN | ACKNOWLEDGED | CLOSED | DECLINED

  // ─── Originator (outgoing staff member) ─────────────────────────────
  raisedAt              DateTime @default(now())
  originatorName        String
  originatorRole        String? // doctor | nurse | charge-nurse | admin
  originatorBy          String? // username snapshot
  originatorById        Int?
  originatorSignatureId String? // SignatureBlob FK

  // ─── Receiver (incoming staff member) ───────────────────────────────
  acknowledgedAt      DateTime?
  receiverName        String?
  receiverRole        String?
  receiverBy          String?
  receiverById        Int?
  receiverSignatureId String? // SignatureBlob FK

  // ─── Supervisor (only required for RATIO_BREACH escalation) ─────────
  supervisorName        String?
  supervisorBy          String?
  supervisorById        Int?
  supervisorSignatureId String? // SignatureBlob FK

  // ─── Clinical context ────────────────────────────────────────────────
  rationale        String  @db.Text // why this handover is being raised
  patientsAffected String? @db.LongText // JSON array — see header comment
  pendingTasks     String? @db.Text // free-text checklist of must-dos
  declineReason    String? @db.Text

  // ─── Closure ─────────────────────────────────────────────────────────
  closedAt DateTime?
  closedBy String?

  // ─── System ──────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([wardId])
  @@index([raisedAt])
}

// ============================================================================
// PHASE 9.6 — ICU CLINICAL ARTEFACTS (NABH COP.3 — Critical Care)
//
// Once IpdIcuTransferRequest reaches COMPLETED status, the admission is
// flagged with `icuAdmittedAt` and the following clinical artefacts
// become the source of truth for the patient's ICU stay. All seven tables
// are admission-scoped (FK → IpdAdmission) so they survive ward changes.
//
// Step-down is its own request type (IcuStepDownRequest) which mirrors
// the transfer-in request pattern but in reverse (ICU → ward).
// ============================================================================

// COP.3 — Hourly ICU vitals + ventilator settings + ABG.
//
// Distinct from IpdVitalsReading (which is 4-hourly ward cadence + no vent
// fields). Ventilator + ABG columns are nullable so non-ventilated ICU
// patients (NIV, room-air observation) can still use the same chart.
model IcuVitalsReading {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt      DateTime
  // Cadence flag — typically 60 (hourly) for ICU; can drop to 30 or 15 for
  // unstable patients. Used by the UI to decide grid density.
  intervalMinutes Int      @default(60)

  // Vitals
  hr   Int? // heart rate (bpm)
  sbp  Int? // systolic
  dbp  Int? // diastolic
  map  Int? // mean arterial pressure (computed or measured)
  rr   Int? // respiratory rate
  spo2 Int? // SpO2 %
  temp Float? // °C
  gcs  Int? // 3..15
  cvp  Int? // central venous pressure (mmHg)

  // Ventilator (null on room air / NIV with no machine settings)
  ventilatorMode  String? // 'VC' | 'PC' | 'SIMV' | 'PSV' | 'CPAP' | 'NIV' | 'HFNC'
  fiO2            Int? // %
  peep            Int? // cmH2O
  pressureSupport Int? // cmH2O
  tidalVolume     Int? // mL
  respRateSet     Int? // set RR on vent

  // Arterial blood gas (optional, sampled subset of rows)
  abgPh      Float?
  abgPco2    Float?
  abgPo2     Float?
  abgHco3    Float?
  abgBe      Float? // base excess
  abgLactate Float?

  // Inotrope / vasopressor running rates (free-text snapshot — drug + dose)
  inotropes String? @db.Text

  notes        String? @db.Text
  recordedBy   String?
  recordedById Int?

  createdAt DateTime @default(now())

  @@index([admissionId, recordedAt])
}

// COP.3 — Daily intensivist progress note with critical-care scoring.
// Separate from IpdProgressNote so SOFA/APACHE are first-class columns
// (not buried in free-text), and so MRD can pull ICU notes independently.
model IcuProgressNote {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  noteDate     DateTime
  icuDayNumber Int // computed: noteDate - icuAdmittedAt (days)
  doctorName   String
  doctorId     Int?

  // SOAP — copied from ward progress note shape so MRD reads consistently
  subjective String @db.LongText
  objective  String @db.LongText
  assessment String @db.LongText
  plan       String @db.LongText

  // ICU-specific scoring (entered as integers — UI shows ranges)
  sofaScore   Int? // 0..24 (Sequential Organ Failure Assessment)
  apacheScore Int? // 0..71 (APACHE II)
  gcsScore    Int? // 3..15 (Glasgow Coma Scale)

  // Trajectory tag — drives the "are we improving" view
  trajectory String? // 'improving' | 'stable' | 'deteriorating' | 'critical'

  signedAt    DateTime?
  signedBy    String?
  signatureId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([admissionId, noteDate])
}

// COP.3 — Per-shift sedation + analgesia scoring (RASS + CPOT).
// RASS: −5 (unarousable) … 0 (alert & calm) … +4 (combative).
// CPOT: 0 (no pain) … 8 (worst pain) — used when patient can't self-report.
model IcuSedationLog {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt DateTime
  shift      String? // 'morning' | 'evening' | 'night'

  rassScore    Int? // −5 … +4
  rassBehavior String? @db.Text
  cpotScore    Int? // 0 … 8
  cpotBehavior String? @db.Text

  sedativeAgent  String? // 'propofol' | 'midazolam' | 'dexmedetomidine' | 'none' | other
  sedativeRate   String? // dose/rate snapshot (free-text)
  analgesicAgent String? // 'fentanyl' | 'morphine' | 'paracetamol' | 'none' | other
  analgesicRate  String?

  // Sedation goal — RASS target the team is aiming for
  rassGoal Int?

  notes        String? @db.Text
  recordedBy   String?
  recordedById Int?

  createdAt DateTime @default(now())

  @@index([admissionId, recordedAt])
}

// COP.3 — Restraint orders + 4-hourly review log. NABH explicitly audits
// that restraints have a written order, the reason is documented, and the
// patient is checked every 4 hours while restrained.
model IcuRestraintLog {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  orderedAt   DateTime
  orderedBy   String // doctor name
  orderedById Int?
  reason      String   @db.Text // 'self-extubation risk' | 'agitation' | etc.

  // 'physical-soft' | 'physical-hard' | 'chemical' (sedation as restraint) | 'mitten'
  restraintType String
  bodyPart      String? // 'both wrists' | 'left wrist + ankle' | 'mittens both hands' | …

  // 4-hourly nursing review log — JSON array of { reviewedAt, reviewedBy, status: 'continue'|'discontinue', notes }
  reviewLog String? @db.LongText

  // Discontinuation
  discontinuedAt     DateTime?
  discontinuedBy     String?
  discontinuedReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, orderedAt])
}

// COP.3 — ICU bundle compliance daily checklist.
// Five preventable harms NABH audits in ICU: VAP (ventilator-associated
// pneumonia), CLABSI (central-line bloodstream infection), CAUTI (catheter
// urinary infection), pressure ulcer, DVT.
//
// `status` per item: 'done' | 'not-applicable' | 'deferred' (with reason).
model IcuBundleLog {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  chartDate DateTime // start-of-day

  vapStatus           String? // 'done' | 'not-applicable' | 'deferred'
  vapNotes            String? @db.Text
  clabsiStatus        String?
  clabsiNotes         String? @db.Text
  cautiStatus         String?
  cautiNotes          String? @db.Text
  pressureUlcerStatus String?
  pressureUlcerNotes  String? @db.Text
  dvtStatus           String?
  dvtNotes            String? @db.Text

  // Glycemic control — bundle-adjacent (insulin sliding scale check)
  glycemicControlStatus String?
  glycemicControlNotes  String? @db.Text

  recordedBy   String?
  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([admissionId, chartDate])
  @@index([admissionId])
}

// COP.3 / PRE.1 — Family communication log. Mandatory for prognosis
// discussions, informed consent for procedures, and end-of-life decisions.
model IcuFamilyCommunication {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  communicationAt     DateTime
  // 'prognosis' | 'procedure-consent' | 'goals-of-care' | 'end-of-life' |
  // 'transfer-explanation' | 'update' | 'other'
  category            String
  participantName     String
  participantRelation String // 'spouse' | 'parent' | 'son' | 'daughter' | etc.
  participantPhone    String?

  topicsDiscussed        String  @db.LongText
  decisionsReached       String? @db.LongText
  // Did the family request a second opinion?
  secondOpinionRequested Boolean @default(false)
  // Was an intensivist + family meeting (multi-party) held?
  multiPartyMeeting      Boolean @default(false)

  documentedBy   String
  documentedById Int?
  signatureId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, communicationAt])
  @@index([category])
}

// COP.3 — ICU step-down request (ICU → ward back-transfer).
// Mirrors IpdIcuTransferRequest direction-reversed. Lifecycle:
//   PROPOSED → ACKNOWLEDGED (intensivist signs off) → ACCEPTED (target ward
//   confirms bed) → IN_TRANSIT → COMPLETED.
// On COMPLETED, sets IpdAdmission.icuDischargedAt and clears icuAdmittedAt.
model IcuStepDownRequest {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  // PROPOSED → ACKNOWLEDGED → ACCEPTED → IN_TRANSIT → COMPLETED → DECLINED
  status String @default("PROPOSED")

  // Snapshot at proposal time
  fromWardId String?
  fromBedId  String?
  toWardId   String? // target step-down ward (filled at ACCEPTED)
  toBedId    String?

  // Clinical context driving the step-down decision
  rationale           String  @db.Text // why patient is ready
  stepDownCriteriaMet Boolean @default(false) // off-pressors + stable RR/HR + GCS≥10 + extubated
  ongoingMeds         String? @db.LongText
  carryForwardOrders  String? @db.LongText
  codeStatus          String? // 'full-code' | 'DNR' | 'DNI' | 'comfort-care'

  // Signature chain
  proposedBy          String
  proposedById        Int?
  proposerSignatureId String?
  proposedAt          DateTime @default(now())

  intensivistSignedAt      DateTime?
  intensivistSignedBy      String?
  intensivistSignatureId   String?
  intensivistDeclineReason String?   @db.Text

  receivingNurseAcceptedAt  DateTime?
  receivingNurseName        String?
  receivingNurseSignatureId String?

  inTransitAt         DateTime?
  completedAt         DateTime?
  completedBy         String?
  handoverSignatureId String? // bedside handover at the receiving ward

  cancelReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, status])
  @@index([status])
}

// ============================================================================
// PHASE 9.16 — ICU NURSES CARE RECORD (paper "Nurses Care Record ICU")
// Nurse-driven ICU documentation: invasive-line register (with line-days),
// the nursing care plan (goals checklist + GOAL/PLANNING/IMPLEMENTATION/
// OUTCOME), and free-text special notes. Distinct from the doctor-driven
// IcuProgressNote and the bundle-compliance IcuBundleLog.
// ============================================================================

// One row per invasive line. `removedAt` null = still in situ; line-days are
// computed (now − insertedAt, or removedAt − insertedAt) for CLABSI/CAUTI/VAP
// surveillance.
model IcuInvasiveLine {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  // 'peripheral' | 'central' | 'arterial' | 'hd-catheter' | 'trach-et' | 'foley'
  lineType      String
  site          String?
  insertedAt    DateTime
  removedAt     DateTime?
  removalReason String?
  insertedBy    String?
  notes         String?   @db.Text

  recordedBy   String?
  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([admissionId, lineType])
  @@index([admissionId, removedAt])
}

// Nursing care plan — one row per shift/day. The 15 intervention goals are
// booleans; the GOAL/PLANNING/IMPLEMENTATION/OUTCOME grid is a JSON array of
// rows (variable count) so the structured part stays in `carePlanRows`.
model IcuNursingCarePlan {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  planDate DateTime
  shift    String? // 'M' | 'E' | 'N'

  // Nursing Intervention / Goals checklist
  goalPatentAirway        Boolean @default(false)
  goalAdequateOxygenation Boolean @default(false)
  goalTissuePerfusion     Boolean @default(false)
  goalFluidBalance        Boolean @default(false)
  goalPainRelief          Boolean @default(false)
  goalNutrition           Boolean @default(false)
  goalPreventDvt          Boolean @default(false)
  goalSkinIntegrity       Boolean @default(false)
  goalActivityTolerance   Boolean @default(false)
  goalPersonalHygiene     Boolean @default(false)
  goalEliminationNeed     Boolean @default(false)
  goalSafety              Boolean @default(false)
  goalReduceAnxiety       Boolean @default(false)
  goalCommunication       Boolean @default(false)
  goalPatientFamilyEducation Boolean @default(false)

  // GOAL / PLANNING / IMPLEMENTATION / OUTCOME — JSON array of
  // { goal, planning, implementation, outcome } rows.
  carePlanRows String? @db.LongText

  nurseName        String?
  nurseEmpNo       String?
  nurseSignatureId String?

  recordedBy   String?
  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([admissionId, planDate])
}

// ICU nurse "Special Notes" — timestamped free-text entries with nurse
// attribution (name + employee no), optional e-signature.
model IcuNurseNote {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt       DateTime
  note             String   @db.Text
  nurseName        String?
  nurseEmpNo       String?
  nurseSignatureId String?

  recordedBy   String?
  recordedById Int?
  createdAt    DateTime @default(now())

  @@index([admissionId, recordedAt])
}

// ============================================================================
// PHASE 3 — IPD BED REQUEST (WF-2 admission handshake)
// One row per bed-request event. Implements the three-party handshake:
//   PRE / billing proposes  →  NS accepts (or holds / rejects)  →  attender
//   signs facility acceptance at the bedside.
// Each transition records who and when, plus signatures via SignatureBlob FKs.
// ============================================================================
model IpdBedRequest {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id])

  wardId           String?
  preferredBedType String? // "general" | "semi-private" | "private" | "ICU" | "HDU"
  urgency          String  @default("routine") // "routine" | "urgent" | "emergency"

  // ─── Lifecycle ────────────────────────────────────────────────────────
  status String @default("REQUESTED")
  // REQUESTED → ACCEPTED → ATTENDER_ACCEPTED → CLOSED
  //                     ↘ HELD (with reason; can be re-requested)
  //                     ↘ REJECTED (with reason; admission goes back to PROPOSED)

  // ─── Originator (PRE / billing) ──────────────────────────────────────
  requestedAt   DateTime @default(now())
  requestedBy   String? // username snapshot
  requestedById Int?

  // ─── Receiver (nursing station) ──────────────────────────────────────
  acceptedAt              DateTime?
  acceptedBy              String?
  acceptedById            Int?
  nsAcceptanceSignatureId String? // FK to SignatureBlob

  holdReason   String? @db.Text
  rejectReason String? @db.Text

  // ─── Attender bedside acceptance ─────────────────────────────────────
  attenderAcceptedAt          DateTime?
  attenderName                String?
  attenderRelation            String?
  attenderFacilitySignatureId String?

  // ─── System ──────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId])
  @@index([status])
  @@index([wardId, status])
  @@index([requestedAt])
}

// Sprint 4a · Phase 1e — Daily bed census snapshot for NABH audit trail.
// One row per (snapshotDate, wardId). Generated by midnight cron; also supports manual/recovery writes.
model BedCensusSnapshot {
  id              Int      @id @default(autoincrement())
  snapshotDate    DateTime
  snapshotTime    DateTime @default(now())
  wardId          String
  wardName        String
  wardCode        String
  department      String
  totalBeds       Int
  occupiedBeds    Int
  availableBeds   Int
  maintenanceBeds Int
  reservedBeds    Int
  generalBeds     Int      @default(0)
  icuBeds         Int      @default(0)
  hduBeds         Int      @default(0)
  isolationBeds   Int      @default(0)
  snapshotReason  String // 'cron' | 'manual' | 'recovery'
  createdById     Int?
  createdAt       DateTime @default(now())

  @@unique([snapshotDate, wardId])
  @@index([snapshotDate])
  @@index([wardId])
  @@index([snapshotReason])
}

// ============================================================================
// PHASE 0 — NABH FOUNDATION MODELS
// Shared infrastructure consumed by every later phase (consent, admission
// handshake, daily closure, staff handover, OT, incident, discharge AI).
// ============================================================================

// Generic in-app audit log. Distinct from HmisAuditLog (which captures
// HMIS push/pull traffic only). This table records WHO did WHAT inside
// Docminds for any clinically- or financially-relevant event.
//
// Tied to NABH IMS.5 (audit trail) and PSQ.7 (incident traceability).
// Every Phase 1+ controller writes one row per user-driven write.
model AppAuditLog {
  id         String   @id @default(uuid())
  module     String // e.g. "patient" | "consent" | "incident" | "ipd" | "ot"
  action     String // e.g. "CREATE" | "UPDATE" | "STATUS_CHANGE" | "SIGN" | "DELETE"
  entityType String? // e.g. "IpdAdmission" | "IncidentReport" | "ConsentSignature"
  entityId   String? // FK as string (works for both Int and UUID source tables)
  payload    String?  @db.LongText // optional JSON snapshot of what changed
  notes      String?  @db.Text // free text reason (e.g., override reason)
  actorId    Int? // User.id when present (matches existing createdById pattern)
  actorName  String? // snapshot of username at time of action
  actorRole  String? // role snapshot (super_admin | sub_admin | admin | doctor | unknown)
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([module, action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Security request log — one row per inbound API request (fire-and-forget).
// Distinct from AppAuditLog (business actions): this captures the raw access
// trail for security monitoring, including anonymous/unauthenticated calls
// and probes for files outside the API. Written by middleware/security-logger.
model SecurityRequestLog {
  id          String   @id @default(uuid())
  method      String // HTTP method
  path        String   @db.Text // query string stripped
  statusCode  Int
  responseMs  Int // response time in milliseconds
  ip          String?
  userAgent   String?  @db.Text
  userId      Int? // User.id when a valid token was present
  anonymous   Boolean  @default(true) // true when no valid auth token
  suspicious  Boolean  @default(false) // flagged by threat classifier
  threatRules String?  @db.Text // JSON array of matched rule keys
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
  @@index([suspicious])
}

// Global rate-limit IP block. A row is written when an IP trips the global
// limiter; a super_admin can unblock it (sets active=false). Blocks may also
// auto-expire via expiresAt. The limiter caches active rows in memory.
model SecurityIpBlock {
  id          String    @id @default(uuid())
  ip          String    @unique
  reason      String? // why it was blocked (e.g. "rate limit: 640 req/60s")
  hitCount    Int       @default(0)
  active      Boolean   @default(true)
  blockedAt   DateTime  @default(now())
  expiresAt   DateTime? // null = until manually unblocked
  unblockedBy String? // username of the super_admin who unblocked
  unblockedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
  @@index([expiresAt])
}

// Message recipient phone numbers, grouped by purpose (groupKey). Lets each
// deployment (= one Hospital/client) manage WhatsApp/SMS recipients from the
// DB instead of hardcoding them in source. Read via getRecipientPhones().
model NotificationRecipient {
  id        String   @id @default(uuid())
  groupKey  String // e.g. "estimation_alert" | "dashboard_screenshot" | "whatsapp_admin"
  phone     String // digits only, country-coded (e.g. "919880544866")
  label     String? // human note (e.g. "Front office", "Dr. X")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupKey, phone])
  @@index([groupKey, isActive])
}

// Reusable signature capture record. One row per signature event
// (consent sign-off, MAR attender ack, handover sign, CAPA close, etc.).
// The actual signature image is stored at `blobUrl` (S3 / GCS / local).
//
// Tied to NABH PRE.4 (informed consent), AAC.10.d (handover sign-off),
// COP.14.e (operative note signature), PSQ.7 (incident closure ack).
model SignatureBlob {
  id                String   @id @default(uuid())
  blobUrl           String   @db.LongText // image URL (data URI for small inline, otherwise object-storage URL)
  mimeType          String   @default("image/png")
  signerType        String // "doctor" | "nurse" | "patient" | "attender" | "supervisor" | "witness" | "other"
  signerId          Int? // User.id when the signer is staff; null for patient/attender
  signerName        String // snapshot — never deleted even if user is removed
  signerRole        String? // role snapshot for staff signers
  signerRelation    String? // for attender: "father" | "spouse" | etc.
  capturedAt        DateTime @default(now())
  deviceFingerprint String? // browser fingerprint for forensic trail
  ipAddress         String?
  sha256Hash        String? // hash of the blob bytes — integrity check
  contextType       String? // optional reverse-link: "consent" | "handover" | "mar-ack" | "capa" | "incident-close"
  contextId         String? // id of the consuming row (kept loose so any model can link)
  createdAt         DateTime @default(now())

  @@index([signerType, signerId])
  @@index([contextType, contextId])
  @@index([capturedAt])
}

// Lightweight feature-flag table. Each phase ships behind a flag so the
// hospital can enable rollout per-ward / per-role.
//
// Reads are cached on the frontend on app boot; writes are admin-only.
model FeatureFlag {
  id           Int      @id @default(autoincrement())
  flagKey      String   @unique // e.g. "phase8.incident-module"
  description  String
  enabled      Boolean  @default(false)
  rolloutScope String   @default("global") // "global" | "role:doctor" | "ward:icu-1" | comma list
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedById  Int?
  updatedBy    String?

  @@index([flagKey])
  @@index([enabled])
}

// ============================================================================
// PHASE 2 — CONSENT MODULE
// One reusable consent system used by every later phase: admission, ICU
// transfer, OT, blood transfusion, photography, high-risk procedures,
// research, end-of-life. Tied to NABH PRE.4 (informed consent) and PRE.2.g
// (consent before transfusion / surgery / anaesthesia / research).
// ============================================================================

// Master template for one consent type at one version in one language.
// Versioning matters: when the legal/policy team updates the wording, we
// publish a new row with bumped `version` and mark the old one inactive.
// All historical signatures stay linked to the version that was signed.
model ConsentForm {
  id              String    @id @default(uuid())
  consentType     String // "admission" | "treatment" | "anaesthesia" | "blood" | "financial" | "photography" | "high-risk" | "research" | "end-of-life"
  version         String // e.g. "1.0", "2.1" — bump when wording changes
  language        String    @default("en") // "en" | "hi" | "kn" | "ta" | "te" | "ml"
  title           String // displayed at the top of the form
  bodyText        String    @db.LongText // the actual consent text shown to patient
  pdfTemplateUrl  String? // optional GCS URL of pre-rendered PDF letterhead
  requiresWitness Boolean   @default(false) // some consents (e.g. high-risk surgery) require a witness signature
  isActive        Boolean   @default(true) // false = retired version, kept for audit
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  createdById     Int?

  signatures ConsentSignature[]

  @@unique([consentType, version, language])
  @@index([consentType, language, isActive])
}

// One row per signed consent event. Links to:
//   • the ConsentForm version that was shown (immutable history)
//   • the SignatureBlob(s) captured (Phase 0)
//   • the consuming context (admission id, OT schedule id, transfusion id, etc.)
//
// Patient + attender signatures live as separate FKs because both can sign
// (e.g. patient is conscious and capable; attender signs on behalf for a minor).
model ConsentSignature {
  id     String      @id @default(uuid())
  formId String
  form   ConsentForm @relation(fields: [formId], references: [id])

  consentType String // duplicated from form for fast filtering
  version     String // duplicated from form
  language    String // duplicated from form

  // Reverse-link to the consuming row. Kept loose (string) so any model fits.
  // Examples: contextType="admission", contextId="42"
  //           contextType="ot-schedule", contextId="ot-uuid"
  contextType String?
  contextId   String?

  // Patient identity at signing time (snapshot — survives PRN changes).
  patientPrn  Int?
  patientName String?

  // Patient signature (when patient is conscious & capable).
  patientSignatureId String? // FK → SignatureBlob (Phase 0)
  patientSignedAt    DateTime?

  // Attender signature (when patient is unable / minor / unconscious).
  attenderSignatureId String? // FK → SignatureBlob
  attenderName        String?
  attenderRelation    String? // "father" | "spouse" | "guardian" | etc.
  attenderSignedAt    DateTime?

  // Witness signature (only required when ConsentForm.requiresWitness = true).
  witnessSignatureId String? // FK → SignatureBlob
  witnessName        String?
  witnessSignedAt    DateTime?

  // Status — captures emergency-exception path per PRE.4.d (consent deferred).
  status         String  @default("SIGNED") // "SIGNED" | "DEFERRED" | "REFUSED" | "WITHDRAWN"
  deferredReason String? // e.g. "patient unconscious; attender unreachable; emergency"
  refusedReason  String?

  // System
  signedAt    DateTime @default(now())
  createdBy   String?
  createdById Int?

  @@index([consentType, contextType, contextId])
  @@index([patientPrn])
  @@index([signedAt])
  @@index([status])
}

// ============================================================================
// PHASE 2.5 — REVENUE ROLLUP (WF-1)
// Nightly aggregate of paid services per (date, department, doctor, type).
// Drives `/report/revenue?by=department|doctor`. Re-computed nightly so the
// table stays compact (one row per group, never per appointment).
// ============================================================================
model RevenueRollup {
  id               Int      @id @default(autoincrement())
  date             String // YYYY-MM-DD — natural string key (matches Appointment.date)
  departmentId     Int?
  departmentName   String?
  doctorId         Int?
  doctorName       String?
  serviceType      String // "opd-consultation" | "investigation" | "package" | "ipd" | "ot" | "other"
  appointmentCount Int      @default(0)
  totalAmount      Float    @default(0)
  computedAt       DateTime @default(now())

  @@unique([date, departmentId, doctorId, serviceType])
  @@index([date])
  @@index([departmentId, date])
  @@index([doctorId, date])
}

// ============================================================================
// DIETETICS & CANTEEN MODULE — NABH COP.7 / COP.8 / HIC.4 / PSQ.5 / MOM.1.d
//
// Clinical half (dietician + doctor + nurse):
//   DietMaster → DietPlan → MealOrder → MealDelivery → MealIntake
//
// Operational half (kitchen / canteen TV):
//   MealOrder rows from across admissions are consolidated by mealTime + ward
//   and surfaced on the canteen workspace + TV channel display.
//
// Snapshot pattern (same as note-templates / discharge):
//   DietPlan stores restrictionsSnapshot + allergensSnapshot at sign-time so
//   future changes to the live DietMaster do not mutate signed plans.
// ============================================================================

// Admin-configurable meal-time slots (default seeded: breakfast/lunch/snacks/dinner).
model MealTimeSlot {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  startTime String
  endTime   String
  sequence  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuRows   MenuPlan[]
  mealOrders MealOrder[]

  @@index([sequence])
}

// Allergen master — referenced by MealMaster (M-to-N) and by DietPlan.allergensSnapshot.
model AllergenMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals MealAllergen[]
}

// DietMaster — catalogue of standard diets the dietician can prescribe.
model DietMaster {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String? @db.Text

  caloriesKcal Int?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  sodiumMg     Float?
  potassiumMg  Float?
  fluidMl      Int?

  restrictions String? @db.Text

  isVeg           Boolean @default(false)
  isJain          Boolean @default(false)
  isHalal         Boolean @default(false)
  isKosher        Boolean @default(false)
  isNoOnionGarlic Boolean @default(false)

  targetConditions String? @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  dietPlans  DietPlan[]
  mealCompat DietMealCompat[]
  menuRows   MenuPlan[]

  @@index([isActive])
}

// MealMaster — individual food items the kitchen can prepare.
model MealMaster {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?  @db.Text
  category     String?
  caloriesKcal Int?
  isVeg        Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  compatibleDiets DietMealCompat[]
  allergens       MealAllergen[]
  menuRows        MenuPlan[]
  mealOrders      MealOrder[]
}

// Meal ↔ Diet many-to-many: which diets a given meal item is suitable for.
model DietMealCompat {
  id           String     @id @default(uuid())
  dietMasterId String
  diet         DietMaster @relation(fields: [dietMasterId], references: [id], onDelete: Cascade)
  mealMasterId String
  meal         MealMaster @relation(fields: [mealMasterId], references: [id], onDelete: Cascade)

  @@unique([dietMasterId, mealMasterId])
  @@index([mealMasterId])
}

// Meal ↔ Allergen many-to-many.
model MealAllergen {
  id           String         @id @default(uuid())
  mealMasterId String
  meal         MealMaster     @relation(fields: [mealMasterId], references: [id], onDelete: Cascade)
  allergenId   String
  allergen     AllergenMaster @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([mealMasterId, allergenId])
  @@index([allergenId])
}

// MenuPlan — weekly menu per (diet × dayOfWeek × meal time).
model MenuPlan {
  id             String       @id @default(uuid())
  dietMasterId   String
  diet           DietMaster   @relation(fields: [dietMasterId], references: [id], onDelete: Cascade)
  mealTimeSlotId String
  mealTimeSlot   MealTimeSlot @relation(fields: [mealTimeSlotId], references: [id], onDelete: Cascade)
  mealMasterId   String
  meal           MealMaster   @relation(fields: [mealMasterId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dietMasterId, mealTimeSlotId, dayOfWeek])
  @@index([dietMasterId])
}

// DietPlan — one row per IPD admission per dietician re-assessment.
model DietPlan {
  id           String     @id @default(uuid())
  admissionId  String
  dietMasterId String
  diet         DietMaster @relation(fields: [dietMasterId], references: [id])

  startDate DateTime  @default(now())
  endDate   DateTime?
  npoUntil  DateTime?

  restrictionsSnapshot String? @db.LongText
  allergensSnapshot    String? @db.LongText
  notesForKitchen      String? @db.Text

  noteTemplateId  String?
  templatedValues String? @db.LongText

  signedAt    DateTime?
  signedBy    String?
  signedById  Int?
  signatureId String?

  status String @default("DRAFT")

  reassessmentReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  mealOrders MealOrder[]

  @@index([admissionId, status])
  @@index([status])
  @@index([signedAt])
}

// MealOrder — one row per (admission, meal-time, scheduled date).
model MealOrder {
  id             String       @id @default(uuid())
  admissionId    String
  dietPlanId     String
  dietPlan       DietPlan     @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  mealTimeSlotId String
  mealTimeSlot   MealTimeSlot @relation(fields: [mealTimeSlotId], references: [id])
  mealMasterId   String?
  meal           MealMaster?  @relation(fields: [mealMasterId], references: [id])

  scheduledFor DateTime
  wardId       String?
  bedId        String?

  status String @default("ORDERED")

  platedAt    DateTime?
  platedBy    String?
  deliveredAt DateTime?
  deliveredBy String?

  kitchenNotes String? @db.Text
  skipReason   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery MealDelivery?
  intake   MealIntake?

  @@unique([admissionId, mealTimeSlotId, scheduledFor])
  @@index([scheduledFor, status])
  @@index([wardId, scheduledFor])
  @@index([status])
}

// MealDelivery — nurse signs at bedside that THIS tray reached THIS patient.
model MealDelivery {
  id          String    @id @default(uuid())
  mealOrderId String    @unique
  mealOrder   MealOrder @relation(fields: [mealOrderId], references: [id], onDelete: Cascade)

  deliveredAt   DateTime @default(now())
  deliveredBy   String?
  deliveredById Int?
  signatureId   String?

  twoIdVerified Boolean @default(false)

  trayHotTempC  Float?
  trayColdTempC Float?

  notes String? @db.Text

  createdAt DateTime @default(now())
}

// MealIntake — % consumed + complaints. Feeds PSQ.5 KPI.
model MealIntake {
  id          String    @id @default(uuid())
  mealOrderId String    @unique
  mealOrder   MealOrder @relation(fields: [mealOrderId], references: [id], onDelete: Cascade)

  percentConsumed Int
  complaint       String? @db.Text
  notes           String? @db.Text
  negativeFlag    Boolean @default(false)

  recordedAt   DateTime @default(now())
  recordedBy   String?
  recordedById Int?

  @@index([negativeFlag])
}

// DrugFoodInteraction — built-in catalogue, joined against active prescriptions.
model DrugFoodInteraction {
  id           String  @id @default(uuid())
  match        String
  severity     String  @default("info")
  foodGuidance String  @db.Text
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([match])
}

// CanteenChannel — TV channel target for the canteen display.
model CanteenChannel {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)
  viewSpec String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// Staff scheduling + duty acknowledgement (Part B).
// Drives the roster grid, the post-login duty-ack modal, and the ward kiosk
// sign-in page. The audit query `who-was-on-duty(ward, timestamp)` joins
// these to surface the staff member(s) who had signed an acknowledgement
// covering any given clinical event — closes the NABH gap where the existing
// handover / MAR / ICU-transfer signatures could be made by someone not on
// the rostered shift.
// ────────────────────────────────────────────────────────────────────────────

// ShiftDefinition — Morning / Evening / Night master. Free-form `startTime`
// and `endTime` (`HH:mm`) so wrap-around night shifts (22:00 → 06:00) work.
model ShiftDefinition {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  startTime String
  endTime   String
  sequence  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments StaffShiftAssignment[]

  @@index([isActive, sequence])
}

// StaffShiftAssignment — one row per (user × date × shift). Wards are
// optional because non-ward roles (OT Coordinator, Therapist) still get
// rostered but aren't tied to a specific ward.
model StaffShiftAssignment {
  id      String          @id @default(uuid())
  userId  Int
  user    User            @relation(fields: [userId], references: [id])
  shiftId String
  shift   ShiftDefinition @relation(fields: [shiftId], references: [id])
  wardId  String?
  ward    IpdWard?        @relation(fields: [wardId], references: [id])
  date    DateTime
  status  String          @default("SCHEDULED") // SCHEDULED | ACKNOWLEDGED | COMPLETED | NO_SHOW | CANCELLED
  notes   String?         @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?

  acknowledgements DutyAcknowledgement[]

  @@unique([userId, date, shiftId])
  @@index([date, wardId])
  @@index([wardId, date])
  @@index([userId, date])
  @@index([status])
}

// DutyAcknowledgement — the signed "I was on duty" evidence. References a
// SignatureBlob so the auditor can replay the pen-and-paper-equivalent trail.
// `source` lets us tell whether it came from the post-login modal or the
// ward kiosk page.
model DutyAcknowledgement {
  id             String               @id @default(uuid())
  assignmentId   String
  assignment     StaffShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId         Int
  user           User                 @relation(fields: [userId], references: [id])
  acknowledgedAt DateTime             @default(now())
  signatureId    String?
  source         String               @default("MODAL") // MODAL | KIOSK
  notes          String?              @db.Text

  createdAt DateTime @default(now())

  @@index([assignmentId])
  @@index([userId, acknowledgedAt])
  @@index([acknowledgedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Nursing Stations (Phase NS-1)
//
// A NursingStation is a named grouping of wards (e.g. "3rd Floor Station",
// "ICU Complex"). Nurses are mapped to one or more stations; a nurse's
// "allowed wards" for ward-scoped views = the union of wards across all the
// stations they're assigned to.
//
//   NursingStation ──< NursingStationWard >── IpdWard   (station ↔ ward, m:n)
//   User ──< NurseStationAssignment >── NursingStation  (nurse ↔ station, m:n)
//
// The Nursing Superintendent (User.subAdminType = 'Nursing Superintendent')
// and super_admin own these mappings and bypass ward scoping (see all wards).
// ────────────────────────────────────────────────────────────────────────────
model NursingStation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  // 'IPD' — ward-based station (nurses see admissions in its wards).
  // 'OPD' — OPD station (nurses see all of today's OPD appointments; wards N/A).
  type        String   @default("IPD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  wardLinks  NursingStationWard[]
  nurseLinks NurseStationAssignment[]

  @@index([code])
  @@index([isActive])
}

// Join — which wards belong to a station (many-to-many).
model NursingStationWard {
  id        String         @id @default(uuid())
  stationId String
  station   NursingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  wardId    String
  ward      IpdWard        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([stationId, wardId])
  @@index([wardId])
  @@index([stationId])
}

// Join — which nurses are mapped to a station (many-to-many).
model NurseStationAssignment {
  id        String         @id @default(uuid())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String
  station   NursingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  createdBy String?

  @@unique([userId, stationId])
  @@index([stationId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// IPD Initial Assessment on Admission (Phase 1)
//
// One row per IPD admission, captured by the admitting M.O. / resident /
// registrar and co-signed by the consultant. Mirrors the printed
// "Initial Assessment on Admission (Adult)" form used at partner hospitals
// (United Hospital UHJ/IPS/F-02, Gunasheela equivalent) — see PDFs supplied
// for the source layout.
//
// Field shape follows the printed form 1:1 so the digital record is a clean
// substitute for the paper form (NABH AAC.4 — initial assessment, AAC.6 —
// reassessment, MRD.1 — record completeness).
//
// Co-morbidity checkboxes have a paired `*Since` text field so the doctor
// can capture duration ("HTN since 2010"). Medication history is captured
// as a single long-text field rather than rows because the printed form
// uses a freeform area for it.
// ────────────────────────────────────────────────────────────────────────────
model IpdInitialAssessment {
  id          String       @id @default(uuid())
  admissionId String       @unique
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  // ─── Header context (snapshot — kept separate from IpdAdmission so the
  // form is self-contained if the admission is later edited) ──────────
  department          String?
  admittingConsultant String?

  // ─── Allergies (NABH MOM.1.b) ─────────────────────────────────────────
  allergyNotKnown    Boolean @default(false)
  allergyDrug        Boolean @default(false)
  allergyFood        Boolean @default(false)
  allergyTransfusion Boolean @default(false)
  allergyOthers      String? @db.Text

  // ─── Pregnancy / lactation (Phase 7 — drives teratogenic-drug alerts) ─
  isPregnant     Boolean @default(false)
  pregnancyWeeks Int?
  isLactating    Boolean @default(false)

  // ─── Form 4 (Phase 8) — F-01 'Relevant Previous Investigations Enclosed' ─
  // Tracks whether the patient brought prior labs/imaging at admission. NABH
  // AAC.1 evidence — auditor checks this against the attached enclosures.
  previousInvestigationsEnclosed Boolean @default(false)

  // ─── Presenting illness ────────────────────────────────────────────────
  chiefComplaints   String? @db.LongText
  presentingIllness String? @db.LongText

  // ─── Personal history / habits ─────────────────────────────────────────
  occupationStatus  String? // employed | unemployed
  occupationDetails String? @db.Text
  dietType          String? // veg | non-veg | mixed
  bowelBladder      String? // regular | irregular
  sleep             String? // normal | disturbed
  habits            String? @db.Text

  // ─── Past medical history — co-morbidities checklist ──────────────────
  hasHypertension         Boolean @default(false)
  hypertensionSince       String?
  hypertensionMeds        String?
  hasDiabetes             Boolean @default(false)
  diabetesSince           String?
  diabetesMeds            String?
  hasCardiacDisease       Boolean @default(false)
  cardiacDiseaseSince     String?
  cardiacDiseaseMeds      String?
  hasWoundDischarge       Boolean @default(false)
  woundDischargeSince     String?
  hasCopd                 Boolean @default(false)
  copdSince               String?
  hasThyroidDisorder      Boolean @default(false)
  thyroidDisorderSince    String?
  hasCva                  Boolean @default(false)
  cvaSince                String?
  hasRecurrentInfection   Boolean @default(false)
  recurrentInfectionSince String?

  // ─── Past surgical + medication history ───────────────────────────────
  surgicalHistory   String? @db.LongText
  medicationHistory String? @db.LongText

  // ─── OB/GYN (female patients) ─────────────────────────────────────────
  lmp              String?
  cycleRegular     Boolean?
  contraception    Boolean?
  discharge        Boolean?
  cervicalSmear    Boolean?
  immunization     String?
  obPain           Boolean?
  menarche         String?
  menopause        String?
  menorrhagia      Boolean?
  obstetricHistory String?  @db.Text

  // ─── Family history ───────────────────────────────────────────────────
  familyHistory String? @db.LongText

  // ─── Geriatric ADL (NABH COP.8 — vulnerable patient screening) ────────
  isGeriatric          Boolean @default(false)
  mentalStatus         String? @db.Text
  emotional            String? @db.Text
  communicationsSpeech String? @db.Text
  mobility             String? @db.Text
  balance              String?
  bowel                String?
  bladder              String?
  nutrition            String? @db.Text
  adl                  String? @db.Text
  social               String?
  hearing              String?
  vision               String?

  // ─── Vital signs at admission ─────────────────────────────────────────
  vitalsTemp   String?
  vitalsPulse  String?
  vitalsBP     String?
  vitalsRR     String?
  vitalsWeight String?
  vitalsHeight String?
  painScore    Int?
  painLocation String?
  painDuration String?

  // ─── General examination ──────────────────────────────────────────────
  examPallor        Boolean @default(false)
  examEdema         Boolean @default(false)
  examClubbing      Boolean @default(false)
  examCyanosis      Boolean @default(false)
  examIcterus       Boolean @default(false)
  examEmaciated     Boolean @default(false)
  examBodyHabitus   String? // obese | average | thin
  examPsychological String? // anxious | depressed | aggressive | altered | normal
  examLymphNode     String? @db.Text
  examOthers        String? @db.Text

  // ─── Systemic examination (per system: NAD flag + free-text findings) ─
  cvsNad       Boolean @default(false)
  cvsFindings  String? @db.Text
  entNad       Boolean @default(false)
  entFindings  String? @db.Text
  giNad        Boolean @default(false)
  giFindings   String? @db.Text
  mskNad       Boolean @default(false)
  mskFindings  String? @db.Text
  cnsNad       Boolean @default(false)
  cnsFindings  String? @db.Text
  respNad      Boolean @default(false)
  respFindings String? @db.Text
  guNad        Boolean @default(false)
  guFindings   String? @db.Text
  hemNad       Boolean @default(false)
  hemFindings  String? @db.Text

  // ─── Summary / plan ───────────────────────────────────────────────────
  findings              String? @db.LongText
  provisionalDiagnosis  String? @db.LongText
  investigationsAdvised String? @db.LongText
  problems              String? @db.LongText
  treatmentPlan         String? @db.LongText
  otherSystems          String? @db.LongText

  // ─── Discharge planning at admission (NABH AAC.8) ─────────────────────
  needsSocialSupport  Boolean @default(false)
  needsHomeEquipment  Boolean @default(false)
  needsPhysiotherapy  Boolean @default(false)
  needsWoundCare      Boolean @default(false)
  otherDischargeNeeds String? @db.Text

  // ─── Sign chain ───────────────────────────────────────────────────────
  // The filler (MO / resident / registrar) signs first; the consultant
  // co-signs to mark the assessment as final.
  filledByName          String?
  filledById            Int?
  filledBySignatureId   String?
  filledAt              DateTime?
  consultantName        String?
  consultantId          Int?
  consultantSignatureId String?
  consultantSignedAt    DateTime?

  // ─── Lifecycle ────────────────────────────────────────────────────────
  status      String   @default("DRAFT") // DRAFT | FILLED | CONSULTANT_SIGNED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@index([status])
  @@index([filledAt])
  @@index([consultantSignedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Clinical Chart (Phase 2 — NABH MRD.1, COP.2, IPSG.6)
//
// Three tables that together back the printed Clinical / TPR chart used at
// partner hospitals (United UHJ/IPS/F-09, Dasappa TPR, Gunasheela):
//
//   1. IpdVitalsReading      — one row per slot (multiple per day). Captures
//                              temperature, pulse, RR, BP, SpO2, pain at a
//                              specific timestamp.
//   2. IpdIntakeOutputEntry  — one row per fluid event. Summed per-day to
//                              produce "Total Intake" / "Total Output" on
//                              the chart.
//   3. IpdDailyChart         — one row per (admission × date). Holds the
//                              day-level text fields the printed form has
//                              (diet, bowels, antibiotics, blood transfusion,
//                              weight/height, post-op day, per-shift nurse
//                              signs).
//
// The chart view reads from all three and groups by date for display.
// ────────────────────────────────────────────────────────────────────────────

// Per-slot vitals (multiple readings per day). The printed chart has columns
// like AM/PM × 2/6/10 — that's the typical cadence but not enforced; nurses
// can record whenever clinically indicated.
model IpdVitalsReading {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now())
  shift      String? // 'M' | 'E' | 'N' — derived from recordedAt but stored so it survives DST/TZ edits

  temperatureC Float?
  temperatureF Float?
  pulse        Int? // bpm
  respiration  Int? // /min
  bpSystolic   Int?
  bpDiastolic  Int?
  spo2         Int? // %
  painScore    Int? // 0-10
  sputum       String? // PDF 2 (Dasappa) explicitly captures sputum
  notes        String? @db.Text

  // Phase 9.13 — NEWS2 inputs not otherwise captured. Optional so legacy
  // rows score on the 5 params they have; a full NEWS2 needs both.
  consciousnessAcvpu   String? // 'A' | 'C' | 'V' | 'P' | 'U' (ACVPU scale)
  onSupplementalOxygen Boolean @default(false)

  recordedBy   String?
  recordedById Int?
  signatureId  String? // optional — per-slot signing is rare but supported

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, recordedAt])
  @@index([recordedAt])
}

// ============================================================================
// PHASE 9.13 — TREATMENT DASHBOARD (NEWS2 deterioration watchboard)
//
// PatientAcuitySnapshot caches a computed NEWS2 score per admission. One
// row is written per vitals reading (IPD or ICU), so the table doubles as
// the EWS-trend history. The watchboard reads the latest row per admission;
// the patient drawer reads a time range for the trend graph.
// ============================================================================
model PatientAcuitySnapshot {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  source          String // 'IPD' | 'ICU' — which vitals stream drove the score
  ewsScore        Int // NEWS2 aggregate 0..20
  ewsBand         String // 'low' | 'low-medium' | 'medium' | 'high'
  componentScores String?   @db.Text // JSON — per-parameter NEWS2 sub-scores
  trend           String? // 'improving' | 'stable' | 'worsening' (vs prior snapshot)
  // Phase 9.13 (Phase C) — true when score rose across 3 consecutive readings.
  risingStreak    Boolean   @default(false)
  vitalsReadingId String? // FK-ish — the IpdVitalsReading / IcuVitalsReading id
  vitalsRecordedAt DateTime?
  computedAt      DateTime  @default(now())

  @@index([admissionId, computedAt])
  @@index([ewsBand])
  @@index([computedAt])
}

// Phase 9.13 — escalation / acknowledgement log for the Treatment Dashboard.
// Every "acknowledge", "escalate" or "review" action a clinician takes on a
// watchboard patient is appended here for the audit trail.
model AcuityEscalation {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  action    String // 'ACKNOWLEDGE' | 'ESCALATE' | 'REVIEW'
  ewsScore  Int? // score at the time of the action (snapshot)
  note      String?  @db.Text
  byName    String?
  byId      Int?
  createdAt DateTime @default(now())

  @@index([admissionId, createdAt])
  @@index([action])
}

// Per-event intake / output log. Each fluid in or fluid out is a separate
// row so the daily total can be computed. Frequent entry pattern is the IV
// bag in / urine bag out events.
model IpdIntakeOutputEntry {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  recordedAt  DateTime @default(now())
  entryType   String // 'INTAKE' | 'OUTPUT'
  category    String // intake: oral | iv | ng | parenteral | blood-product | other
  // output: urine | stool | vomitus | drain | ng-aspirate | blood | other
  amountMl    Int // millilitres; small enough as Int (no fluid event is > 2,147,483,647 mL)
  description String?  @db.Text

  recordedBy   String?
  recordedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionId, recordedAt])
  @@index([entryType])
}

// Per-day rollup. One row per (admission × calendar date). Holds the
// day-level text fields the printed chart has — these are filled once per
// shift by the nurse, not aggregated from elsewhere.
model IpdDailyChart {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  chartDate     DateTime // start-of-day anchor
  postOpDay     Int? // P.O. — days since most recent surgery
  postPartumDay Int? // P.P. — days since delivery
  weightKg      Float?
  heightCm      Float?

  // Free-text fields the printed form keeps as a single cell per day
  diet             String? @db.Text
  bowels           String? // e.g. "passed × 2"
  urine            String? // free-text qualifier (clear / cloudy / oliguria)
  bloodTransfusion String? @db.Text
  bloodGroup       String?
  noOfTransfusions Int?
  antibiotics      String? @db.Text
  bath             String? // PDF 3 (Gunasheela) captures this
  allergy          String? @db.Text

  // Nurse sign per shift (M/E/N) — links to SignatureBlob
  nurseSignMorningId   String?
  nurseSignMorningName String?
  nurseSignMorningAt   DateTime?
  nurseSignEveningId   String?
  nurseSignEveningName String?
  nurseSignEveningAt   DateTime?
  nurseSignNightId     String?
  nurseSignNightName   String?
  nurseSignNightAt     DateTime?

  // System
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@unique([admissionId, chartDate])
  @@index([chartDate])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 3 — Per-admission SBAR Hand-off (NABH PSQ.5 / HRM.5 evidence)
//
// One row per (admission × calendar date × shift). The outgoing nurse fills
// the writable SBAR fields and signs; the incoming nurse acknowledges with
// their own signature. The "auto-pulled" sections (drugs given, drugs due,
// vitals trend, I/O totals, current problems) are NOT stored here — they're
// LIVE-read from IpdMedicationLog / IpdPrescription / IpdVitalsReading /
// IpdIntakeOutputEntry / IpdInitialAssessment by the handover-pull endpoint.
//
// This row captures only the nurse-typed narrative + nurse signatures. The
// data the receiver actually relies on stays fresh at every render.
// ────────────────────────────────────────────────────────────────────────────
model IpdHandover {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  chartDate DateTime // calendar date the shift belongs to (start-of-day anchor)
  shift     String // 'M' | 'E' | 'N'

  // ─── Situation & Background (per-admission context the nurse narrates) ──
  postOpDay     Int?
  diet          String? @db.Text
  ventilation   String? @db.Text // 'self / NIV / IPPV / etc.'
  invasiveLines String? @db.LongText // free-form text (or JSON array — UI decides)

  // ─── Assessment (per-shift narrative — these are nurse judgement calls) ─
  infusionsTransfusions String? @db.LongText
  puProphylaxis         String? @db.Text // pressure-ulcer prophylaxis
  dvtProphylaxis        String? @db.Text
  painScale             Int? // 0-10 at handover moment
  gcsLoc                String? @db.Text
  skinIntegrity         String? @db.Text
  restraints            String?
  fallRisk              String?
  adl                   String? @db.Text
  ambulation            String? @db.Text
  criticalLabValues     String? @db.LongText
  currentProblems       String? @db.LongText

  // ─── Recommendations (next-shift priorities) ──────────────────────────
  investigationsOrdered String? @db.LongText
  reportsPending        String? @db.LongText
  referrals             String? @db.LongText // JSON: [{consultant, timeInformed, timeSeen}]
  nextShiftPriorities   String? @db.LongText

  // ─── Sign chain ───────────────────────────────────────────────────────
  handedOverById          Int?
  handedOverByName        String?
  handedOverBySignatureId String?
  handedOverAt            DateTime?
  takenOverById           Int?
  takenOverByName         String?
  takenOverBySignatureId  String?
  takenOverAt             DateTime?

  status      String   @default("DRAFT") // DRAFT | HANDED_OVER | ACKNOWLEDGED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@unique([admissionId, chartDate, shift])
  @@index([admissionId, chartDate])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 4b — Intra-Operative Nursing Chart (NABH COP.13.c, IPSG.4).
//
// Captured by the scrub/floor nurses during a procedure. Complements the
// existing OtIntraOpNote (the doctor's narrative) and OtSafetyChecklist
// (the WHO sign-in / time-out / sign-out). Mirrors the printed UHJ/OTS/F-02
// form: wheel in/out times, position, pressure protections, tourniquet,
// catheters, instruments + swabs count by named type, specimen handover.
//
// Sign chain: scrub nurse → floor nurse → OT in-charge.
// ────────────────────────────────────────────────────────────────────────────
model OtIntraOpNursingChart {
  id         String     @id @default(uuid())
  scheduleId String     @unique
  schedule   OtSchedule @relation(name: "ScheduleToNursing", fields: [scheduleId], references: [id], onDelete: Cascade)

  // ─── Transfer + anaesthesia header ────────────────────────────────────
  wheelInAt      DateTime?
  wheelOutAt     DateTime?
  modeOfTransfer String? // 'bed' | 'stretcher' | 'wheelchair'
  anaesthesia    String? // 'GA' | 'SA' | 'EA' | 'REGIONAL' | 'BLOCK_MAC' | 'LOCAL'
  position       String? // 'supine' | 'prone' | 'lithotomy' | 'left-lateral' | 'right-lateral' | 'others'
  positionNotes  String?   @db.Text

  // ─── Pressure protections (free-form selected list — printed form has
  // 11 checkboxes; we store as comma-separated keys to keep schema flat) ─
  pressureProtections String? @db.Text // e.g. 'head,sandbags,axillary-roll,eye-protections'

  // ─── Equipment used ───────────────────────────────────────────────────
  warmerPlaced       String? // 'YES' | 'NO' | 'NA'
  dvtPumpApplied     String? // 'YES' | 'NO' | 'NA'
  electricCautery    String? // 'YES' | 'NA'
  cauteryPadLocation String?

  // ─── Tourniquet (4 limbs each with applied/released times) ────────────
  // Stored as JSON so the printed form's 4-rows layout is preserved without
  // adding 8 columns to the schema.
  tourniquet String? @db.LongText // JSON: [{limb, appliedAt, releasedAt}]

  // ─── Catheters / lines ────────────────────────────────────────────────
  // JSON array: [{type, size, site, remarks, signedBy}]
  catheters String? @db.LongText

  // ─── Counts ───────────────────────────────────────────────────────────
  // Instruments — JSON array of {name, initialCount, additionalCount, finalCount, scrubInitials, floorInitials}
  instrumentsCount String? @db.LongText

  // Swabs by named type — flat columns mirror the printed form for speed.
  // Each type carries initial/additional/final counts + nurse-initial cells.
  swabRoMopInitial          Int?
  swabRoMopAdditional       Int?
  swabRoMopFinal            Int?
  swabRoGauzeInitial        Int?
  swabRoGauzeAdditional     Int?
  swabRoGauzeFinal          Int?
  swabPlainGauzeInitial     Int?
  swabPlainGauzeAdditional  Int?
  swabPlainGauzeFinal       Int?
  swabThroatPackInitial     Int?
  swabThroatPackAdditional  Int?
  swabThroatPackFinal       Int?
  swabPattiesInitial        Int?
  swabPattiesAdditional     Int?
  swabPattiesFinal          Int?
  swabPeanutsInitial        Int?
  swabPeanutsAdditional     Int?
  swabPeanutsFinal          Int?
  swabRibbonPacksInitial    Int?
  swabRibbonPacksAdditional Int?
  swabRibbonPacksFinal      Int?
  swabsCountTallied         Boolean @default(false) // 'all counts match' flag

  // ─── Specimens to laboratory ──────────────────────────────────────────
  specimensCulture        String?   @db.Text
  specimensHistopathology String?   @db.Text
  specimensOther          String?   @db.Text
  specimenHandedOverBy    String?
  specimenHandedOverAt    DateTime?
  specimenReceivedBy      String?
  specimenReceivedAt      DateTime?

  // ─── End-of-procedure state ───────────────────────────────────────────
  conditionAtEnd        String? // 'stable' | 'fair' | 'critical'
  dressingType          String? // 'compression' | 'simple' | 'immobilizer' | 'pop-cast'
  dressingNotes         String? @db.Text
  patientShiftedTo      String? // 'recovery' | 'icu' | 'ward' | 'others'
  patientShiftedToOther String?

  // ─── Sign chain ───────────────────────────────────────────────────────
  scrubNurseName        String?
  scrubNurseId          Int?
  scrubNurseSignatureId String?
  scrubNurseSignedAt    DateTime?
  floorNurseName        String?
  floorNurseId          Int?
  floorNurseSignatureId String?
  floorNurseSignedAt    DateTime?
  otInchargeName        String?
  otInchargeId          Int?
  otInchargeSignatureId String?
  otInchargeSignedAt    DateTime?

  status      String   @default("DRAFT") // DRAFT | SIGNED_SCRUB | SIGNED_FLOOR | SIGNED_INCHARGE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@index([status])
  @@index([wheelInAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 5 — Day Care Monitoring (NABH COP.6 — day-care services).
//
// For OUTPATIENTS undergoing day procedures (dialysis, chemo, endoscopy,
// day-surgery). Distinct from IPD: no admission row, no bed assignment.
// One session per visit; readings table captures the time-series vitals
// during the procedure. Doctor sets per-patient alert thresholds at start;
// when a reading breaches a threshold the row carries an `alertsTriggered`
// JSON list so the UI can highlight it.
// ────────────────────────────────────────────────────────────────────────────
model DayCareSession {
  id               String   @id @default(uuid())
  prn              String? // optional — links to PatientDetails when available
  patientName      String
  age              Int?
  gender           String?
  dateOfService    DateTime
  procedureType    String // 'chemo' | 'dialysis' | 'endoscopy' | 'day-surgery' | 'other'
  procedureDetails String?  @db.Text
  allergies        String?  @db.Text
  consultantName   String?

  // ─── Alert thresholds (NABH COP.6.b — "alert duty doctor if vitals
  // breach the range set at the start of the session") ────────────────
  spo2Low         Int?
  spo2High        Int?
  bpSystolicLow   Int?
  bpSystolicHigh  Int?
  bpDiastolicLow  Int?
  bpDiastolicHigh Int?
  hrLow           Int?
  hrHigh          Int?
  rrLow           Int?
  rrHigh          Int?
  tempLow         Float? // °F
  tempHigh        Float?
  uopLow          Int? // mL — total for session
  uopHigh         Int?

  // ─── Procedure flow ──────────────────────────────────────────────────
  startedAt    DateTime?
  completedAt  DateTime?
  dischargedAt DateTime?
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | DISCHARGED | CANCELLED

  readings DayCareReading[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  createdById Int?
  updatedBy   String?
  updatedById Int?

  @@index([prn])
  @@index([dateOfService])
  @@index([status])
}

// Per-time-row monitoring reading. The printed form has roughly 30 rows
// per session — one per 15-minute interval is typical.
model DayCareReading {
  id        String         @id @default(uuid())
  sessionId String
  session   DayCareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  recordedAt         DateTime @default(now())
  spo2               Int?
  bpSystolic         Int?
  bpDiastolic        Int?
  hr                 Int?
  rr                 Int?
  tempF              Float?
  uopMl              Int?
  ivPatency          String? // 'patent' | 'blocked' | 'na'
  consciousnessLevel Int? // 1=Alert | 2=Obeys verbal | 3=Responds to pain | 4=No response
  remarks            String?  @db.Text
  alertsTriggered    String?  @db.Text // JSON array of threshold-breach names — computed on save

  recordedBy   String?
  recordedById Int?
  signatureId  String?

  createdAt DateTime @default(now())

  @@index([sessionId, recordedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 7 — IPD Non-Drug Doctor Orders (UHJ/IPS/F-05 second page).
//
// For the orders that aren't drugs: "NPO from midnight", "ambulate qid",
// "physiotherapy referral", "X-ray chest AP/lateral", etc. Currently many
// teams write these in the progress-note `plan` field — this entity gives
// them a separate, trackable log with a doctor + nurse acknowledgement
// chain so it's clear what's been actioned.
// ────────────────────────────────────────────────────────────────────────────
model IpdNonDrugOrder {
  id          String       @id @default(uuid())
  admissionId String
  admission   IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  orderedAt         DateTime @default(now())
  doctorName        String
  doctorId          Int?
  doctorSignatureId String?
  orderText         String   @db.Text
  category          String? // 'diet' | 'mobility' | 'investigation' | 'procedure' | 'consult' | 'other'

  // Nurse acknowledgement
  acknowledgedByName      String?
  acknowledgedById        Int?
  acknowledgedSignatureId String?
  acknowledgedAt          DateTime?

  // Completion (e.g. X-ray ordered → film done)
  completedByName String?
  completedById   Int?
  completedAt     DateTime?
  completionNotes String?   @db.Text

  status String @default("ORDERED") // ORDERED | ACKNOWLEDGED | COMPLETED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([admissionId, orderedAt])
  @@index([status])
}

// ─── Phase 9.19 — Emergency referral acknowledgment + auto-escalation ──────
//
// The ER doctor refers a case to a doctor/surgeon, who must acknowledge it
// within a triage-driven SLA. If not, a cron climbs a per-department
// escalation chain, notifying the next tier each interval (in-app bell).

model EmergencyReferral {
  id                 Int       @id @default(autoincrement())
  emergencyId        Int
  emergency          Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  referredToDoctorId Int
  referredToDoctor   Doctor    @relation("DoctorEmergencyReferrals", fields: [referredToDoctorId], references: [id])

  referredByName String?
  referredById   Int?
  reason         String? @db.Text

  triageCategory String // snapshot at creation (drives the SLA)
  slaMinutes     Int // snapshot — later config changes don't move existing deadlines

  status             String    @default("pending") // pending | acknowledged | cancelled
  referredAt         DateTime  @default(now())
  acknowledgedAt     DateTime?
  acknowledgedByName String?
  acknowledgedById   Int?

  // 0 = the originally referred doctor; 1..N = chain steps already notified.
  escalationLevel Int       @default(0)
  lastEscalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emergencyId])
  @@index([referredToDoctorId])
  @@index([status])
}

model EscalationChainStep {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  level          Int // ordered: 1, 2, 3 …
  targetType     String // 'doctor' | 'role'
  targetDoctorId Int?
  targetDoctor   Doctor? @relation("DoctorEscalationSteps", fields: [targetDoctorId], references: [id])
  targetRole     String? // when targetType = 'role' (e.g. 'admin', 'super_admin')
  label          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, level])
}

model ReferralSlaConfig {
  id             Int      @id @default(autoincrement())
  triageCategory String   @unique // red | yellow | green
  minutes        Int
  updatedAt      DateTime @updatedAt
}

// ─── Phase 9.20 — Hospital emergency codes (Code Blue / Red / Pink …) ──────
//
// One row per code activation. The 7 codes + their dial number (3111) are
// fixed in code (from the printed poster); this table records each event:
// who raised it, where, optional patient link (Code Blue), and resolution.
// Patient/admission links are kept loose (no FK) like other cross-module ids.

model CodeActivation {
  id          Int    @id @default(autoincrement())
  code        String // 'blue' | 'red' | 'pink' | 'violet' | 'yellow' | 'orange' | 'black'
  situation   String // snapshot label, e.g. 'Cardiac arrest / medical emergency'
  dialNumber  String // '3111'
  location    String // ward/bed or free text — announced with the code

  // Optional clinical context (Code Blue raised for a specific patient).
  admissionId String?
  emergencyId Int?
  patientName String?

  status        String    @default("active") // active | resolved
  autoSuggested Boolean   @default(false) // true if it came from the suggestion engine
  note          String?   @db.Text

  triggeredByName String?
  triggeredById   Int?
  triggeredAt     DateTime @default(now())

  resolvedByName String?
  resolvedById   Int?
  resolvedAt     DateTime?

  // Phase 9.26 / Phase 5i — team arrival timestamp. Powers PSQ-014
  // (Code Blue response time compliance: attendedAt - triggeredAt ≤ 5 min).
  // Nullable so legacy rows remain valid; the responder marks it when they
  // physically reach the patient.
  attendedAt     DateTime?
  attendedByName String?
  attendedById   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([code])
  @@index([triggeredAt])
}

// ─── Phase 9.24 — Incident reporting + CAPA ─────────────────────────────
//
// Tracks adverse events, near-misses and process failures across the patient's
// journey. `source` distinguishes manual raises (any staff member, any screen)
// from the auto-capture rule engine (Phase 2), which fires on-write hooks +
// a cron sweep against IncidentRule. Severity follows the WHO patient-safety
// classification; nabhClause maps each incident to the audit chapter it
// belongs to (PSQ.4 / IPC.1 / MOM.5 / AAC.4 / …).

model Incident {
  id   String @id @default(uuid())
  code String @unique // INC-YYYY-NNNN (human-readable, year-scoped sequence)

  category        String // 'clinical' | 'medication' | 'documentation' | 'fall' | 'infection' | 'equipment' | 'behavioural' | 'security' | 'other'
  severity        String // 'near_miss' | 'minor' | 'moderate' | 'major' | 'sentinel'
  source          String // 'auto-rule' | 'manual'
  ruleKey         String? // set when source = 'auto-rule' — links back to IncidentRule.key

  title       String
  description String @db.LongText

  // Patient / encounter context — any combination may be present.
  patientPrn    String?
  patientName   String?
  admissionId   String?
  emergencyId   Int?
  appointmentId Int?
  ward          String?
  department    String?

  occurredAt   DateTime?
  reportedAt   DateTime  @default(now())
  reportedBy   String?
  reportedById Int?

  // Phase 9.26 / Phase 5c — optional QI tag. Lets a reporter or QI manager
  // attribute an incident to a specific quality indicator (e.g. PSQ-017
  // prescription error vs PSQ-018 dispensing). Auto-source uses this to count
  // sub-types within the same Incident.category.
  qiCode String?

  // Phase 6 / Concern #4 + Option A — cross-module linkage so feedback /
  // complaint and incident records that describe the same encounter aren't
  // orphans. feedbackSurveyId / complaintId set when auto-raised from a
  // patient survey; relatedIncidentIds is a JSON array of sibling Incident.id
  // strings populated reciprocally when an auto-rule raises a second incident
  // on the same patient within 30 days.
  feedbackSurveyId   String?
  complaintId        String? @unique
  relatedIncidentIds String? @db.Text

  status        String  @default("open") // open | triaged | investigated | capa_in_progress | closed | cancelled
  severityFinal String? // revised after investigation
  nabhClause    String? // e.g. 'PSQ.4'
  evidenceLinks String? @db.LongText // JSON array of { label, url }

  triagedAt    DateTime?
  triagedBy    String?
  assignedTo   String?
  assignedToId Int?
  closedAt     DateTime?
  closedBy     String?
  closureNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capa IncidentCapa?

  @@index([status])
  @@index([severity])
  @@index([patientPrn])
  @@index([reportedAt])
  @@index([category, status])
  @@index([qiCode, reportedAt])
}

model IncidentCapa {
  id         String   @id @default(uuid())
  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  immediateActions String? @db.LongText

  // 5-Whys root cause analysis.
  why1      String? @db.Text
  why2      String? @db.Text
  why3      String? @db.Text
  why4      String? @db.Text
  why5      String? @db.Text
  rootCause String? @db.Text

  correctiveActions     String?   @db.LongText
  preventiveActions     String?   @db.LongText
  owner                 String?
  ownerId               Int?
  dueDate               DateTime?
  completedAt           DateTime?
  effectivenessReview   String?   @db.LongText
  effectivenessReviewAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentRule {
  id               Int     @id @default(autoincrement())
  key              String  @unique // e.g. 'IPD_INITIAL_ASSESSMENT_LATE'
  name             String
  description      String  @db.Text
  category         String
  defaultSeverity  String // near_miss|minor|moderate|major|sentinel
  nabhClause       String?
  thresholdMinutes Int? // for time-bound rules
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Phase 9.25 — Patient feedback + complaints ─────────────────────────
//
// Surveys are auto-generated after each encounter (OPD checkout, IPD discharge,
// ER closure) by feedback-send.cron, each with a one-shot signed token. The
// patient opens /feedback/k/:token (no auth) on phone or a kiosk and submits
// NPS + comments. Low scores (<=6) auto-create a Complaint; very low (<=3)
// also raise an Incident (Phase 9.24, category 'behavioural').

model FeedbackSurvey {
  id    String @id @default(uuid())
  token String @unique // signed URL token

  template      String // 'opd-post-visit' | 'ipd-discharge' | 'er-discharge' | 'day-care' | 'general'
  patientPrn    String?
  patientName   String?
  appointmentId Int?
  admissionId   String?
  emergencyId   Int?
  encounterDate DateTime?

  sentAt           DateTime?
  sentChannel      String? // 'sms' | 'whatsapp' | 'kiosk' | 'manual'
  respondedAt      DateTime?
  respondedChannel String?

  // Phase 9.25 / Phase 6d — one-shot follow-up dedupe. Set by
  // feedback-reminder.cron when a "still pending after 72h" bell fires so
  // the cron doesn't spam on every tick. Null = never reminded.
  lastReminderAt   DateTime?

  npsScore             Int? // 0-10 (Net Promoter)
  satisfactionScores   String? @db.LongText // JSON { categoryKey: 1..5 }
  comments             String? @db.Text
  complaintFlag        Boolean @default(false)

  status    String   @default("pending") // 'pending' | 'sent' | 'completed' | 'expired'
  expiresAt DateTime?

  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([template, status])
  @@index([patientPrn])
  @@index([respondedAt])
}

model Complaint {
  id   String @id @default(uuid())
  code String @unique // COMP-YYYY-NNNN

  patientPrn  String?
  patientName String?
  raisedAt    DateTime @default(now())

  channel  String // 'sms' | 'whatsapp' | 'kiosk' | 'phone' | 'in-person' | 'survey-auto'
  source   String // 'survey' | 'manual'
  feedbackSurveyId String?
  feedbackSurvey   FeedbackSurvey? @relation(fields: [feedbackSurveyId], references: [id])

  // Phase 6 / Concern #4 — encounter FKs let the dedup helper find related
  // complaints on the same admission/appointment/ER visit. All nullable —
  // legacy rows + non-encounter-scoped grievances keep working.
  appointmentId Int?
  admissionId   String?
  emergencyId   Int?

  // Phase 6 / Option A — JSON array of related Incident.id strings (sibling
  // links to clinical incidents that describe the same encounter).
  relatedIncidentIds String? @db.Text

  description String @db.LongText
  severity    String // 'low' | 'medium' | 'high'

  assignedTo   String?
  assignedToId Int?

  status          String  @default("open") // 'open' | 'acknowledged' | 'resolved' | 'escalated'
  resolutionNotes String? @db.Text
  slaDueAt        DateTime?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolvedById    Int?

  // Phase 9.25 / Phase 6a — auto-escalation timestamp. Set by the SLA
  // breach cron when status flips to 'escalated'. Distinct from updatedAt
  // (which bumps on every edit) so reporting can answer "what escalated
  // this week". Nullable — legacy + non-escalated rows have null.
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([patientPrn])
  @@index([raisedAt])
}

// ─── Phase 9.26 — NABH/QCI Quality Indicator framework ──────────────────
//
// 108 NABH/QCI indicators across PSQ / ICO / OT / LAB / RAD / PRE / MRD /
// HR / FMS / OPS chapters. The static catalogue lives in
// src/api/quality/quality-indicator-catalogue.ts; QualityIndicator mirrors
// that catalogue so admins can disable/edit a row at runtime. Each
// indicator stores monthly numerator/denominator captures in
// QualityIndicatorRecord; Red/Critical records spawn a QualityIndicatorRca
// (5-why / CAPA, same shape as IncidentCapa but tied to a QI record).

model QualityIndicator {
  id     Int    @id @default(autoincrement())
  qiCode String @unique // e.g. 'PSQ-001', 'ICO-006'

  chapter      String // 'PSQ' | 'ICO' | 'OT' | 'LAB' | 'RAD' | 'PRE' | 'MRD' | 'HR' | 'FMS' | 'OPS'
  nabhRef      String // 'PSQ 3a' | 'NABH Clinical QI' | 'PRE / Patient Rights QI' …
  department   String // 'IPD' | 'Laboratory' | 'Radiology' | 'OPD' | …
  name         String
  indicatorType String // 'Process' | 'Outcome' | 'Process/Outcome' | 'Structure'

  numeratorDef   String  @db.Text
  denominatorDef String  @db.Text
  multiplier     String // 'NA' | '100' | '1000' — stored as string to match spec
  unit           String // 'Minutes' | '%' | 'Falls / 1000 patient days' | …
  frequency      String // 'Monthly' | 'Monthly / Daily dashboard' | 'Monthly / Event-based' | 'Monthly / Quarterly'

  direction         String // 'higher-is-bad' | 'lower-is-bad' | 'target-range'
  defaultBenchmark  Float? // null when spec says 'Hospital defined'
  amberThresholdPct Float  @default(80) // amber band — 80% of breach per NABH spec
  isCritical        Boolean @default(false) // zero-tolerance / sentinel-class
  criticalRule      String? @db.Text // text describing the critical trigger

  dataCaptureFields String? @db.Text // pipe-separated source fields from spec
  escalationOwner   String // role name from spec, e.g. 'Quality Manager'
  rcaRequiredRule   String // 'always' | 'red-2-consecutive' | 'critical-only' | 'serious-only' | 'never'
  nabhClause        String? // mirrors Incident.nabhClause for cross-module joins
  sourceUrl         String? @db.Text

  isActive Boolean @default(true)
  notes    String? @db.Text

  records QualityIndicatorRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapter])
  @@index([department])
  @@index([isActive])
}

model QualityIndicatorRecord {
  id Int @id @default(autoincrement())

  indicatorId Int
  indicator   QualityIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  qiCode      String // denormalised for quick lookups / scorecard joins

  period   String // 'YYYY-MM' for monthly, 'YYYY-MM-DD' when daily, or event-stamped
  periodStart DateTime
  periodEnd   DateTime

  numerator   Float
  denominator Float
  calculatedValue Float // (numerator / denominator) * multiplier — engine-filled

  benchmarkUsed Float? // copy of benchmark at time of capture (audit trail)
  status        String // 'green' | 'amber' | 'red' | 'critical'
  severity      String // 'low' | 'medium' | 'high' | 'critical'

  autoCalculated Boolean @default(false)
  capturedBy     String?
  capturedById   Int?
  remarks        String? @db.Text
  evidenceLinks  String? @db.LongText // JSON array of { label, url }

  rca QualityIndicatorRca?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicatorId, period])
  @@index([qiCode, period])
  @@index([status])
  @@index([periodStart])
}

model QualityIndicatorRca {
  id       Int    @id @default(autoincrement())
  recordId Int    @unique
  record   QualityIndicatorRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  immediateActions String? @db.LongText

  // 5-Whys root cause analysis (mirrors IncidentCapa).
  why1      String? @db.Text
  why2      String? @db.Text
  why3      String? @db.Text
  why4      String? @db.Text
  why5      String? @db.Text
  rootCause String? @db.Text

  correctiveActions     String?   @db.LongText
  preventiveActions     String?   @db.LongText
  owner                 String?
  ownerId               Int?
  dueDate               DateTime?
  completedAt           DateTime?
  effectivenessReview   String?   @db.LongText
  effectivenessReviewAt DateTime?

  status String @default("open") // 'open' | 'in_progress' | 'closed'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Phase 9.26 / Phase 5a — Generic audit observation log ─────────────
//
// One row per (auditor, indicator, observation moment). Backs ~30 NABH/QCI
// indicators whose denominator is "total observations" and numerator is
// "compliant observations" — hand hygiene, BMW segregation, surgical
// safety checklist, MRD audits, HR training compliance, etc. The auto-
// source layer counts compliant/total per (qiCode, period) and writes a
// QualityIndicatorRecord. Keeps 30 indicators on one table instead of 30
// micro-models.

model QualityAuditObservation {
  id     Int    @id @default(autoincrement())
  qiCode String // FK-by-convention to QualityIndicator.qiCode

  observedAt DateTime @default(now())
  period     String   // YYYY-MM, derived from observedAt at write time

  location        String? // free-text — ward / dept / OT room / etc.
  checkpointKey   String? // optional sub-checkpoint slug for finer rollups
  checkpointLabel String?

  compliant Boolean
  notes     String? @db.Text

  auditor     String?
  auditorId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([qiCode, period])
  @@index([qiCode, observedAt])
  @@index([auditorId])
}

// ─── Phase 9.26 / Phase 5c — Manual monthly denominator counts ─────────
//
// Single store for the "total X this month" denominators NABH expects but no
// existing model exposes: total medication administrations, total
// transfusions, total surgeries, total at-risk admitted patients (pressure
// ulcer), total encounters (wrong patient / privacy breach rates), etc.
// One row per (qiCode, period). Auto-source pulls these to build the rate
// records; when the row is missing the indicator is skipped (no-data).

model QualityMonthlyDenominator {
  id     Int    @id @default(autoincrement())
  qiCode String
  period String  // YYYY-MM

  value Float
  notes String? @db.Text

  capturedBy   String?
  capturedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([qiCode, period])
  @@index([qiCode])
  @@index([period])
}

// ─── Phase 9.26 / Phase 5b — Infection surveillance + device-days ──────
//
// Three small models that back ICO-001..005, ICO-008, HR-006.
// QualitySurveillanceEvent: one row per identified case (HAI / SSI / VAP /
// CAUTI / CLABSI / NSI). Numerators of the rate indicators.
// QualityDeviceDayCount: end-of-day rounding counts per ward + device type.
// Denominators of VAP / CAUTI / CLABSI.
// QualitySterilizationCycle: CSSD log entry per autoclave run. Numerator
// (failed) + denominator (total) of ICO-008.

model QualitySurveillanceEvent {
  id   Int    @id @default(autoincrement())
  type String // 'HAI' | 'SSI' | 'VAP' | 'CAUTI' | 'CLABSI' | 'NSI'

  patientPrn   String?
  admissionId  String?
  ward         String?
  organism     String?
  deviceRelated Boolean @default(false)

  observedAt DateTime @default(now())
  period     String   // YYYY-MM, derived at write time

  notes String? @db.Text

  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, period])
  @@index([type, observedAt])
  @@index([ward])
}

model QualityDeviceDayCount {
  id Int @id @default(autoincrement())

  date       DateTime
  ward       String
  deviceType String   // 'ventilator' | 'urinary_catheter' | 'central_line'
  count      Int

  capturedBy   String?
  capturedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, ward, deviceType])
  @@index([date])
  @@index([deviceType])
}

model QualitySterilizationCycle {
  id Int @id @default(autoincrement())

  batchCode      String?
  runAt          DateTime @default(now())
  passed         Boolean
  failureReason  String?  @db.Text

  capturedBy   String?
  capturedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runAt])
  @@index([passed])
}

// ─── Phase 9.26 / Phase 5f — Facility / equipment / ambulance / maintenance ─
//
// Five small models backing FMS-001..009 (minus FMS-005/006/010 which are
// audit-observation-based in 5a). FacilityEquipment is the inventory; the
// other four are logs.

model FacilityEquipment {
  id   String @id @default(uuid())
  code String @unique
  name String

  type       String?
  isCritical Boolean @default(false)
  location   String?
  department String?
  status     String  @default("operational") // 'operational' | 'breakdown' | 'retired'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events FacilityEquipmentEvent[]

  @@index([isCritical])
  @@index([status])
}

model FacilityEquipmentEvent {
  id          Int    @id @default(autoincrement())
  equipmentId String
  equipment   FacilityEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  eventType   String // 'pm' | 'calibration' | 'breakdown'

  dueAt       DateTime?  // for pm/calibration — when it was due
  occurredAt  DateTime   @default(now()) // for breakdown / completion timestamp
  resolvedAt  DateTime?  // when the breakdown was fixed

  performedBy   String?
  performedById Int?
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId, eventType])
  @@index([eventType, dueAt])
  @@index([eventType, occurredAt])
}

model FacilityUtilityFailure {
  id Int @id @default(autoincrement())

  utilityType     String // 'power' | 'water' | 'gas' | 'oxygen' | 'medical_gas' | 'hvac' | 'other'
  occurredAt      DateTime @default(now())
  durationMinutes Int?
  affectedAreas   String? @db.Text
  notes           String? @db.Text

  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurredAt])
  @@index([utilityType])
}

model FacilityAmbulanceCall {
  id Int @id @default(autoincrement())

  calledAt            DateTime
  dispatchedAt        DateTime?
  arrivedAt           DateTime?
  responseTimeMinutes Int?
  // Computed at write-time against the hospital target (default 8 min).
  // Storing the boolean lets historical reports stay stable if the target
  // is tuned later — FMS-008 just counts withinTarget=true.
  withinTarget Boolean

  notes      String? @db.Text
  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calledAt])
  @@index([withinTarget])
}

model FacilityMaintenanceComplaint {
  id Int @id @default(autoincrement())

  type     String // 'electrical' | 'plumbing' | 'biomedical' | 'civil' | 'other'
  location String?
  notes    String? @db.Text

  raisedAt   DateTime @default(now())
  slaDueAt   DateTime
  status     String   @default("open") // 'open' | 'in_progress' | 'closed'
  closedAt   DateTime?
  closedBy   String?
  closedById Int?

  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([raisedAt])
}

// ─── Phase 9.26 / Phase 5g — Pharmacy stock-out + expired drug log ────
//
// Minimal two-model addition. PharmacyCriticalDrug is the watch list
// (denominator of OPS-003). PharmacyStockEvent logs both stock-out events
// and expired-drug findings — eventType discriminates. OPS-004 denominator
// (total drug items audited) is captured monthly via QualityMonthlyDenominator.

// ─── Phase 9.26 / Phase 5i — Lab / Radiology amendment + repeat log ────
//
// Captures events that don't have a direct field on InvestigationResult:
// amended reports (PSQ-002 / PSQ-003), rejected samples (LAB-001), repeat
// imaging due to technical error (RAD-003). Single table because the
// workflow is identical — lab/radiology head logs the event with a
// reason. Denominators come from InvestigationResult counts.

model QualityLabRadEvent {
  id Int @id @default(autoincrement())

  eventType String // 'lab_amended' | 'rad_amended' | 'lab_sample_rejected' | 'rad_repeat'

  observedAt DateTime @default(now())
  period     String   // YYYY-MM derived at write time

  // Optional context — patient + test, if known.
  prn      String?
  testName String?
  reason   String? @db.Text

  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, period])
  @@index([eventType, observedAt])
}

model PharmacyCriticalDrug {
  id   String @id @default(uuid())
  code String @unique
  name String

  category   String?
  isCritical Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockEvents PharmacyStockEvent[]

  @@index([isCritical])
}

model PharmacyStockEvent {
  id Int @id @default(autoincrement())

  drugId String?
  drug   PharmacyCriticalDrug? @relation(fields: [drugId], references: [id])

  // Drug snapshot fields — kept so events stay readable if the master row
  // is later edited or the drug is delisted.
  drugCodeSnapshot String?
  drugNameSnapshot String?

  eventType   String // 'stock_out' | 'expired'
  occurredAt  DateTime @default(now())

  batchCode  String?
  expiryDate DateTime?
  quantity   Int?

  notes      String? @db.Text
  reporter   String?
  reporterId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, occurredAt])
  @@index([drugId])
}

// ─── Phase 9.26 / Phase 5e — Generic TAT event capture ────────────────
//
// One row per timed workflow event (registration, consultation start,
// triage, etc.). Backs 15 NABH TAT indicators across PSQ and OPS without
// instrumenting the existing ER / OPD / billing / pharmacy controllers.
// Compliance-% indicators store withinTarget computed against a static
// per-indicator target; avg-minutes indicators ignore the boolean and
// average durationMinutes.

// ─── Phase 6 / Batch A — Notification target role aliases ──────────────
//
// Spec strings like "Quality Manager", "grievance_officer", "patient_experience"
// don't match any real User.role / subAdminType. This table maps each alias to
// the concrete string the notification dispatcher should target. Editable from
// the admin UI so operators can re-route notifications without code changes.
// resolveTargetRole() in src/service/role-alias.ts falls back to the literal
// alias when no row exists — zero regression risk if seeding is delayed.

model RoleAlias {
  id     Int    @id @default(autoincrement())
  alias  String @unique // spec name, e.g. 'Quality Manager'
  targetRole String  // UserRole enum value OR User.subAdminType string
  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model QualityTatEvent {
  id     Int    @id @default(autoincrement())
  qiCode String

  startedAt        DateTime
  endedAt          DateTime
  durationMinutes  Int      // (endedAt - startedAt) / 60_000, rounded
  withinTarget     Boolean? // null when the indicator has no compliance target (avg-style)

  location String?
  notes    String? @db.Text

  capturedBy   String?
  capturedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([qiCode, startedAt])
  @@index([qiCode, withinTarget])
}

// ─── WhatsApp patient↔doctor bot (GoBuzz) ──────────────────────────────────
// Conversation state + routed query threads. Doctor/Patient kept as scalar
// refs (no FK) to avoid back-relations on those models, matching how
// Appointment stores doctorName/prnNumber as plain fields.

model WhatsappBotSession {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  state         String   @default("AWAITING_PRN") // AWAITING_PRN | AWAITING_DOCTOR | AWAITING_QUESTION | IN_CONVERSATION
  prn           Int?
  doctorId      Int?
  doctorName    String?
  activeQueryId Int?
  prnAttempts   Int      @default(0) // wrong-PRN counter for abuse throttling
  flow          String?  // active menu branch: APPT | DOORSTEP | ENQUIRY | OTHERS | REPORT
  scratch       String?  @db.Text // JSON blob of fields being collected in the current flow
  otpCode       String?  // last OTP issued (cleared after verify)
  otpExpiresAt  DateTime?
  consentAt     DateTime? // when the user accepted the consent disclaimer
  verifiedPrn   Int?      // PRN this session is OTP-verified for (record access)
  verifiedUntil DateTime? // verification expiry — short-lived
  lastInboundAt DateTime @default(now())
  expiresAt     DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model WhatsappQuery {
  id               Int                    @id @default(autoincrement())
  refNo            String                 @unique
  patientPhone     String
  prn              Int
  patientName      String?
  doctorId         Int
  doctorName       String
  status           String                 @default("open") // open | answered | closed
  lastPatientMsgAt DateTime               @default(now())
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  messages         WhatsappQueryMessage[]

  @@index([doctorId, status])
  @@index([patientPhone])
}

model WhatsappQueryMessage {
  id         Int           @id @default(autoincrement())
  queryId    Int
  direction  String        // IN | OUT
  body       String        @db.Text // text / caption ("" if media-only)
  sender     String?       // patient name (IN) or doctor name (OUT)
  mediaUrl   String?       // e.g. /files/whatsapp/<file> (served by /files static)
  mediaType  String?       // image | document | video | audio
  mediaMime  String?       // e.g. application/pdf, image/jpeg
  fileName   String?       // original filename for documents
  created_at DateTime      @default(now())
  query      WhatsappQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
}

// ─── Doorstep services (WhatsApp bot) ──────────────────────────────────────
// Home lab sample pickup / pharmacy delivery requests raised via the bot.
// Ops team handles them from a panel inbox.

model DoorstepRequest {
  id               Int       @id @default(autoincrement())
  refNo            String    @unique
  patientPhone     String
  prn              Int?
  patientName      String
  serviceType      String // LAB_PICKUP | PHARMACY_DELIVERY
  address          String    @db.Text
  details          String?   @db.Text
  lat              Float?
  lng              Float?
  distanceKm       Float?
  withinFreeRadius Boolean?
  status           String    @default("pending") // pending | scheduled | completed | cancelled
  consentAt        DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status])
  @@index([patientPhone])
}

// ─── Bug #12 — Surgeon / Assistant-surgeon master ──────────────────────────
//
// Surgeons were previously free-text on OT/surgery forms. This dedicated
// catalogue lets admins curate surgeons + assistant surgeons (type discriminator)
// so downstream forms can switch from free-text to a managed dropdown.
model Surgeon {
  id            Int      @id @default(autoincrement())
  name          String
  type          String   @default("surgeon") // 'surgeon' | 'assistant'
  qualification String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Patient record access over WhatsApp ───────────────────────────────────
// Records are only released to an OTP-verified session on the PRN's REGISTERED
// mobile. Files live in a PRIVATE dir (not under /files) and are served only
// through /p/:token, which expires. Every access is audited.

model SecureLink {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  prn        Int
  kind       String // report | opd_note | prescription | discharge_summary | bill
  refId      String?
  filePath   String    @db.Text // absolute path on disk (private storage)
  fileName   String
  mimeType   String    @default("application/pdf")
  expiresAt  DateTime
  firstUsedAt DateTime?
  created_at DateTime  @default(now())

  @@index([expiresAt])
  @@index([prn])
}

model PatientRecordAccessLog {
  id         Int      @id @default(autoincrement())
  prn        Int
  phone      String
  itemType   String // report | opd_note | prescription | discharge_summary | bill | list
  itemRef    String?
  action     String // listed | sent | viewed | denied
  channel    String   @default("whatsapp")
  created_at DateTime @default(now())

  @@index([prn])
  @@index([created_at])
}

// ─── WhatsApp push/journey notifications ───────────────────────────────────
// Every business-initiated (template) message. `refId` de-duplicates so an
// event replay never double-sends to a patient.

model WhatsappNotificationLog {
  id         Int      @id @default(autoincrement())
  prn        Int?
  phone      String
  template   String
  refType    String?
  refId      String?
  status     String // sent | failed | skipped
  error      String?  @db.Text
  created_at DateTime @default(now())

  @@index([template, refId])
  @@index([created_at])
  @@index([prn])
}

// ======================================================================
// OPHTHALMOLOGY — department-specific OPD prescription (ported from
// DocMinds Clinic). One row per consultation: visual acuity, glass power,
// autorefraction, subjective refraction, IOP, slit-lamp examination,
// diagnosis, plus JSON blobs for visual field / EOM / gonioscopy and
// point marks on the eye / cornea / fundus diagrams.
// ======================================================================

model OphthalmologyPrescription {
  id                Int     @id @default(autoincrement())
  prescriptionId    String  @unique
  appointmentId     Int?
  doctorId          Int?
  prn               Int
  opdPrescriptionId String?

  patientName   String
  patientAge    String?
  patientGender String?

  // ================= VISUAL ACUITY =================
  uaVr   String? @db.Text
  uaVl   String? @db.Text
  glVr   String? @db.Text
  glVl   String? @db.Text
  nearVr String? @db.Text
  nearVl String? @db.Text

  // ================= CURRENT GLASS =================
  curSphR  String? @db.Text
  curCylR  String? @db.Text
  curAxisR String? @db.Text
  curVAR   String? @db.Text
  curSphL  String? @db.Text
  curCylL  String? @db.Text
  curAxisL String? @db.Text
  curVAL   String? @db.Text
  curAdd   String? @db.Text
  curIPD   String? @db.Text
  curType  String? @db.Text

  curAddSphR  String? @db.Text
  curAddCylR  String? @db.Text
  curAddAxisR String? @db.Text
  curAddVAR   String? @db.Text

  curAddSphL  String? @db.Text
  curAddCylL  String? @db.Text
  curAddAxisL String? @db.Text
  curAddVAL   String? @db.Text

  // ================= AUTO REFRACTION (BEFORE DILATION) =================
  arSphR  String? @db.Text
  arCylR  String? @db.Text
  arAxisR String? @db.Text
  arVAR   String? @db.Text
  arSphL  String? @db.Text
  arCylL  String? @db.Text
  arAxisL String? @db.Text
  arVAL   String? @db.Text
  arIPD   String? @db.Text

  // ============= AUTO REFRACTION (AFTER DILATION) =============
  // Repeat AR reading taken once the dilating drops have acted — cycloplegic
  // refraction. Same capture as the undilated set above.
  arDilSphR  String? @db.Text
  arDilCylR  String? @db.Text
  arDilAxisR String? @db.Text
  arDilVAR   String? @db.Text
  arDilSphL  String? @db.Text
  arDilCylL  String? @db.Text
  arDilAxisL String? @db.Text
  arDilVAL   String? @db.Text
  arDilIPD   String? @db.Text

  // ================= SUBJECTIVE =================
  srSphR  String? @db.Text
  srCylR  String? @db.Text
  srAxisR String? @db.Text
  srVAR   String? @db.Text
  srSphL  String? @db.Text
  srCylL  String? @db.Text
  srAxisL String? @db.Text
  srVAL   String? @db.Text
  srIPD   String? @db.Text
  srType  String? @db.Text

  srAddSphR  String? @db.Text
  srAddCylR  String? @db.Text
  srAddAxisR String? @db.Text
  srAddVAR   String? @db.Text

  srAddSphL  String? @db.Text
  srAddCylL  String? @db.Text
  srAddAxisL String? @db.Text
  srAddVAL   String? @db.Text

  // ================= IOP =================
  iopR       String?  @db.Text
  iopL       String?  @db.Text
  includeIOP Boolean? @default(false)

  // ================= EXAM =================
  eyelidsR     String? @db.Text
  eyelidsL     String? @db.Text
  eomR         String? @db.Text
  eomL         String? @db.Text
  corneaR      String? @db.Text
  corneaL      String? @db.Text
  anteriorChR  String? @db.Text
  anteriorChL  String? @db.Text
  conjunctivaR String? @db.Text
  conjunctivaL String? @db.Text
  scleraR      String? @db.Text
  scleraL      String? @db.Text
  irisR        String? @db.Text
  irisL        String? @db.Text
  pupilR       String? @db.Text
  pupilL       String? @db.Text
  lensR        String? @db.Text
  lensL        String? @db.Text
  fundusR      String? @db.Text
  fundusL      String? @db.Text

  // ================= PUPIL =================
  pupilReactionR String? @db.Text
  pupilReactionL String? @db.Text

  // ================= DIAGNOSIS =================
  diagnosis     String? @db.Text
  diagnosisList String? @db.LongText
  advice        String? @db.Text
  reviewAfter   String? @db.Text

  vfData    String? @db.LongText // Visual Field
  eomData   String? @db.LongText // Extraocular movements
  gonioData String? @db.LongText // Gonioscopy

  diagramImage String? @db.LongText

  // ================= OPTOMETRIST WORK-UP / DOCTOR VERIFICATION =========
  // The refraction work-up (VA, glass power, AR, SR, IOP) is typically
  // recorded by an optometrist before the consult. Those values stay
  // PROVISIONAL until the doctor verifies them — an optometrist's mis-entry
  // must never silently become the doctor's signed word.
  //   pending   — nothing submitted yet
  //   submitted — optometrist finished; awaiting the doctor
  //   verified  — doctor accepted the values unchanged
  //   amended   — doctor changed one or more values before accepting
  workupStatus String? @default("pending")

  recordedBy   String? // optometrist name snapshot
  recordedById Int? // User.id of the optometrist
  recordedAt   DateTime?

  verifiedBy   String? // doctor name snapshot
  verifiedById Int? // User.id of the verifying doctor
  verifiedAt   DateTime?

  // Immutable copy of exactly what the optometrist submitted. Doctor edits
  // land in the columns above; this keeps the original so the UI can show
  // "was -2.25, changed by doctor" per field.
  workupSnapshot String? @db.LongText

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  diagramMarks    OphthalmologyDiagramMark[]
  doctor          Doctor?                    @relation(fields: [doctorId], references: [id])
  appointment     Appointment?               @relation(fields: [appointmentId], references: [id])
  opdPrescription Prescription?              @relation(fields: [opdPrescriptionId], references: [prescriptionId])

  @@index([doctorId])
  @@index([appointmentId])
  @@index([opdPrescriptionId])
  @@index([prn])
}

// Doctor-extensible pick-list values for the slit-lamp exam dropdowns
// (fieldName = "cornea" | "lens" | "pupil" | ... , optionLabel = the value).
model OphthalmologyExaminationOption {
  id           Int      @id @default(autoincrement())
  fieldName    String
  optionLabel  String
  departmentId Int?
  createdBy    Int?
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id])
  doctor     Doctor?     @relation(fields: [createdBy], references: [id])

  @@index([fieldName])
  @@index([departmentId])
  @@index([createdBy])
}

// In-OPD topical drug administration (drops instilled in the clinic — dilating
// agents, topical anaesthetic, etc). This is an ADMINISTRATION record, not a
// prescription: one row per instillation, append-only, so the dilation timing
// and the 'who gave what, when' evidence survive. Same intent as
// IpdMedicationLog, but OPD/appointment-scoped rather than admission-scoped.
model OphthalmologyDropAdministration {
  id             Int     @id @default(autoincrement())
  prn            Int
  appointmentId  Int?
  prescriptionId String? // links to the eye prescription of the same visit, when saved

  drugName  String
  eye       String // OD | OS | OU
  dropCount Int    @default(1)
  purpose   String? // dilation | anaesthesia | diagnostic | treatment

  instilledAt   DateTime @default(now())
  instilledBy   String? // staff name snapshot
  instilledById Int? // User.id of whoever recorded it
  remarks       String?  @db.Text

  createdAt DateTime @default(now())

  @@index([prn])
  @@index([appointmentId])
  @@index([instilledAt])
}

// A single point the doctor clicked on one of the eye diagrams.
model OphthalmologyDiagramMark {
  id             Int    @id @default(autoincrement())
  prescriptionId String

  diagram String // eye | cornea | fundus
  eye     String // OD | OS

  x     Float
  y     Float
  size  Int
  color String
  label String

  createdAt DateTime @default(now())

  prescription OphthalmologyPrescription @relation(fields: [prescriptionId], references: [prescriptionId], onDelete: Cascade)

  @@index([prescriptionId])
}
