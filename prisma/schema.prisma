model TherapyAppointment {
  id             Int       @id @default(autoincrement())
  prn            Int
  prefix         String?
  name           String
  phone          String
  email          String?
  gender         String?
  age            Int?
  doctorId       Int?
  therapyId      Int?
  roomNumber     String
  date           String // YYYY-MM-DD
  time           String // HH:mm
  status         String?
  checkedIn      Boolean?  @default(false)
  checkedInTime  DateTime?
  checkedInBy    String? // doctor / therapist / admin name or id
  reminderSent   Boolean?  @default(false)
  reminderSentAt DateTime?

  totalDurationMinutes Int? // planned duration

  startedAt  DateTime?
  finishedAt DateTime?
  startedBy  String? // doctor / therapist / admin name or id
  finishedBy String? // doctor / therapist / admin name or id

  cancelledBy String? // doctor / therapist / admin name or id
  cancelledAt DateTime?

  entryDone   Boolean?  @default(false)
  entryDoneAt DateTime?
  entryDoneBy String? // doctor / therapist / admin name or id

  therapyStarted  Boolean? @default(false)
  therapyFinished Boolean? @default(false)

  hasBathing Boolean @default(false)

  // NEW: calculated durations
  therapyDurationMinutes  Int?
  cleaningDurationMinutes Int?
  bathingDurationMinutes  Int?

  // NEW: end therapy
  therapyEnded   Boolean?  @default(false)
  therapyEndedAt DateTime?
  therapyEndedBy String?

  // NEW: end cleaning
  cleaningEnded   Boolean?  @default(false)
  cleaningEndedAt DateTime?
  cleaningEndedBy String?

  cleanedAfterUse   Boolean?  @default(false)
  cleanedAfterUseAt DateTime?
  cleanedAfterUseBy String?

  postponed   Boolean?  @default(false)
  postponedAt DateTime?
  postponedBy String?

  smsSent      Boolean? @default(false)
  emailSent    Boolean? @default(false)
  whatsappSent Boolean? @default(false)

  lockedBy Int?
  userId   Int?

  remarks String?

  // Multi-day therapy course linkage (nullable → standalone bookings unaffected)
  courseId  Int?
  dayNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor? @relation(fields: [doctorId], references: [id])

  therapy Therapy? @relation(fields: [therapyId], references: [id])

  therapists TherapyAppointmentTherapist[]

  therapies TherapyAppointmentTherapy[]

  course  TherapyCourse?         @relation(fields: [courseId], references: [id])
  planDay TherapyCoursePlanDay?  @relation("PlanDayAppointment")

  // Prevent same room being double-booked
  @@unique([roomNumber, date, time], map: "unique_therapy_room_slot")
  @@index([doctorId])
  @@index([therapyId])
  @@index([courseId])
}

model TherapyAppointmentTherapist {
  id            Int @id @default(autoincrement())
  appointmentId Int
  therapistId   Int

  appointment TherapyAppointment @relation(fields: [appointmentId], references: [id])
  therapist   Therapist          @relation(fields: [therapistId], references: [id])

  @@unique([appointmentId, therapistId]) // no duplicate assignment
}

model TherapyAppointmentTherapy {
  id            Int @id @default(autoincrement())
  appointmentId Int
  therapyId     Int

  appointment TherapyAppointment @relation(fields: [appointmentId], references: [id])
  therapy     Therapy            @relation(fields: [therapyId], references: [id])

  @@unique([appointmentId, therapyId])
}

// ── Multi-day therapy course ─────────────────────────────────────────────
// A course is the parent of an N-day treatment plan. The full plan is stored
// upfront in TherapyCoursePlanDay rows; only one day at a time is materialised
// into a slot-holding TherapyAppointment (hybrid model).
model TherapyCourse {
  id     Int     @id @default(autoincrement())
  prn    Int
  prefix String?
  name   String
  phone  String
  email  String?
  gender String?
  age    Int?

  doctorId  Int?
  totalDays Int
  startDate String // YYYY-MM-DD (first planned day)
  status    String  @default("active") // active | completed | cancelled
  remarks   String?
  lockedBy  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor       Doctor?                @relation(fields: [doctorId], references: [id])
  planDays     TherapyCoursePlanDay[]
  appointments TherapyAppointment[]

  @@index([doctorId])
  @@index([prn])
}

// One row per planned day. Holds the template (planned therapists/therapies as
// JSON id lists — MySQL has no scalar list type) and links to the real
// appointment once the day is materialised.
model TherapyCoursePlanDay {
  id        Int    @id @default(autoincrement())
  courseId  Int
  dayNumber Int // 1..totalDays
  status    String @default("planned") // planned | confirmed | completed | missed | rescheduled | cancelled

  plannedDate String // YYYY-MM-DD
  time        String // HH:mm
  roomNumber  String
  hasBathing  Boolean @default(false)

  totalDurationMinutes Int

  // Planned selections (applied when the day is materialised).
  plannedTherapistIds Json // number[]
  plannedTherapyIds   Json // number[]

  appointmentId Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      TherapyCourse       @relation(fields: [courseId], references: [id])
  appointment TherapyAppointment? @relation("PlanDayAppointment", fields: [appointmentId], references: [id])

  @@unique([courseId, dayNumber])
  @@index([plannedDate])
}

// ── Therapist availability (blocks-only model) ───────────────────────────
// Availability = clinic hours (06:00–18:00) − bookings − leave days − blocked
// slots. There is no recurring weekly schedule: a therapist is bookable in
// clinic hours unless explicitly blocked here. Mirrors the doctor's
// UnavailableDates / UnavailableSlot, but keeps `date` as a String
// ("YYYY-MM-DD") to match TherapyAppointment.date.

// Whole day off / on leave.
model TherapistUnavailableDates {
  id          Int       @id @default(autoincrement())
  therapistId Int?
  date        String // YYYY-MM-DD
  createdAt   DateTime? @default(now())
  createdBy   String?
  updatedAt   DateTime? @updatedAt

  therapist Therapist? @relation(fields: [therapistId], references: [id])

  @@unique([therapistId, date])
  @@index([therapistId])
}

// Specific time blocked on a date (lunch, training, ad-hoc busy).
model TherapistUnavailableSlot {
  id          Int       @id @default(autoincrement())
  therapistId Int?
  time        String // HH:mm
  date        String // YYYY-MM-DD
  createdAt   DateTime? @default(now())
  createdBy   String?
  updatedAt   DateTime? @updatedAt

  therapist Therapist? @relation(fields: [therapistId], references: [id])

  @@unique([therapistId, date, time])
}

model CallbackRequest {
